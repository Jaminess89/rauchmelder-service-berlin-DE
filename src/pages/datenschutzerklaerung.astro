---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Datenschutzerklärung | Normcheck Rauchmelderservice",
  "description": "Datenschutzerklärung von Normcheck Rauchmelderservice gemäß DSGVO.",
  "url": `${SITE.url}datenschutzerklaerung/`
};
---

<BaseLayout
  title="Datenschutzerklärung | Normcheck Rauchmelderservice"
  description="Informationen zur Erhebung, Verarbeitung und Nutzung Ihrer personenbezogenen Daten bei Normcheck Rauchmelderservice gemäß DSGVO."
  jsonLd={jsonLd}
>
  <div class="bg-gradient-to-b from-[#3F789E] to-[#204968] text-white py-14 md:py-20" data-ps="src/pages/datenschutzerklaerung.astro:hero">
    <Container>
      <div class="max-w-3xl mx-auto text-center" data-ps="src/pages/datenschutzerklaerung.astro:2k22vx">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white mb-4 tracking-tight" data-ps="src/pages/datenschutzerklaerung.astro:h1">
          Datenschutzerklärung
        </h1>
        <p class="text-white/80 text-base sm:text-lg max-w-xl mx-auto" data-ps="src/pages/datenschutzerklaerung.astro:subtitle">
          Informationen über die Verarbeitung Ihrer personenbezogenen Daten gemäß DSGVO
        </p>
      </div>
    </Container>
  </div>

  <section class="py-12 md:py-16 bg-white" data-ps="src/pages/datenschutzerklaerung.astro:content">
    <Container>
      <div class="max-w-3xl mx-auto prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-8" data-ps="src/pages/datenschutzerklaerung.astro:legal-text">
        
        <p class="text-sm text-slate-500 font-medium" data-ps="src/pages/datenschutzerklaerung.astro:stand">
          Stand: 30. August 2026
        </p>

        <!-- 1. Verantwortlicher -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec1">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-1">
            1. Verantwortlicher
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p1-1">
            Verantwortlicher im Sinne der Datenschutz-Grundverordnung (DSGVO) ist:
          </p>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 my-4" data-ps="src/pages/datenschutzerklaerung.astro:box-owner">
            <p class="font-bold text-slate-900 m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-name">Vladimir Povedich</p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-street">Glasbläserallee 21</p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-city">10245 Berlin</p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-country">Deutschland</p>
            <p class="mt-3 m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-phone">Telefon: <a href="tel:+493086328386" class="text-[#1AAAE6] font-semibold" data-ps="src/pages/datenschutzerklaerung.astro:link-phone">030 863 28 38 6</a></p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-mail">E-Mail: <a href="mailto:info@rauchmelderservice-normcheck.de" class="text-[#1AAAE6]" data-ps="src/pages/datenschutzerklaerung.astro:link-mail">info@rauchmelderservice-normcheck.de</a></p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-sales">Anfragen: <a href="mailto:vertrieb@rauchmelderservice-normcheck.de" class="text-[#1AAAE6]" data-ps="src/pages/datenschutzerklaerung.astro:link-sales">vertrieb@rauchmelderservice-normcheck.de</a></p>
            <p class="mt-2 m-0" data-ps="src/pages/datenschutzerklaerung.astro:owner-site">Website: <a href="https://rauchmelder-service-berlin.de/" class="text-[#1AAAE6]" data-ps="src/pages/datenschutzerklaerung.astro:link-site">rauchmelder-service-berlin.de</a></p>
          </div>
        </div>

        <!-- 2. Allgemeine Hinweise zur Datenverarbeitung -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec2">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-2">
            2. Allgemeine Hinweise zur Datenverarbeitung
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p2-1">
            Wir verarbeiten personenbezogene Daten nur, soweit dies zur Bereitstellung dieser Website, zur Bearbeitung von Anfragen, zur Erstellung von Angeboten, zur Durchführung unserer Leistungen oder zur Erfüllung gesetzlicher Verpflichtungen erforderlich ist.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p2-2">
            Je nach Verarbeitung kommen insbesondere folgende Rechtsgrundlagen zur Anwendung:
          </p>
          <ul class="list-disc pl-5 space-y-1" data-ps="src/pages/datenschutzerklaerung.astro:ul2">
            <li data-ps="src/pages/datenschutzerklaerung.astro:li2-1"><strong>Art. 6 Abs. 1 lit. a DSGVO</strong>: Einwilligung</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li2-2"><strong>Art. 6 Abs. 1 lit. b DSGVO</strong>: Vertragserfüllung und vorvertragliche Maßnahmen</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li2-3"><strong>Art. 6 Abs. 1 lit. c DSGVO</strong>: Erfüllung rechtlicher Verpflichtungen</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li2-4"><strong>Art. 6 Abs. 1 lit. f DSGVO</strong>: Wahrung berechtigter Interessen</li>
          </ul>
          <p class="mt-3" data-ps="src/pages/datenschutzerklaerung.astro:p2-3">
            Soweit Informationen auf Ihrem Endgerät gespeichert oder von diesem ausgelesen werden, gelten ergänzend die Vorschriften des Telekommunikation-Digitale-Dienste-Datenschutz-Gesetzes (TDDDG).
          </p>
        </div>

        <!-- 3. Hosting -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec3">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-3">
            3. Hosting
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p3-1">
            Diese Website wird gehostet bei:
          </p>
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-5 my-4" data-ps="src/pages/datenschutzerklaerung.astro:box-host">
            <p class="font-bold text-slate-900 m-0" data-ps="src/pages/datenschutzerklaerung.astro:host-name">ALL-INKL.COM (Neue Medien Münnich)</p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:host-owner">Inhaber: René Münnich</p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:host-street">Hauptstraße 68</p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:host-city">02742 Friedersdorf</p>
            <p class="m-0" data-ps="src/pages/datenschutzerklaerung.astro:host-country">Deutschland</p>
          </div>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p3-2">
            Beim Aufruf unserer Website verarbeitet der Hostinganbieter technische Daten, die für die Bereitstellung sowie den sicheren und störungsfreien Betrieb der Website erforderlich sind.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p3-3">
            Hierzu können insbesondere gehören:
          </p>
          <ul class="list-disc pl-5 space-y-1" data-ps="src/pages/datenschutzerklaerung.astro:ul3">
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-1">IP-Adresse</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-2">Datum und Uhrzeit des Zugriffs</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-3">aufgerufene Seite oder Datei</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-4">übertragene Datenmenge</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-5">Referrer-URL</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-6">Browsertyp und Browserversion</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-7">Betriebssystem</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li3-8">technische Geräte- und Verbindungsinformationen</li>
          </ul>
          <p class="mt-3" data-ps="src/pages/datenschutzerklaerung.astro:p3-4">
            Die Verarbeitung erfolgt auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO. Unser berechtigtes Interesse besteht in der sicheren, stabilen und effizienten Bereitstellung unserer Website.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p3-5">
            Mit dem Hostinganbieter besteht, soweit erforderlich, eine Vereinbarung zur Auftragsverarbeitung gemäß Art. 28 DSGVO.
          </p>
        </div>

        <!-- 4. Server-Logfiles -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec4">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-4">
            4. Server-Logfiles
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p4-1">
            Beim Zugriff auf unsere Website können automatisch Informationen in sogenannten Server-Logfiles gespeichert werden.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p4-2">
            Hierzu gehören insbesondere:
          </p>
          <ul class="list-disc pl-5 space-y-1" data-ps="src/pages/datenschutzerklaerung.astro:ul4">
            <li data-ps="src/pages/datenschutzerklaerung.astro:li4-1">IP-Adresse</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li4-2">Browsertyp und Browserversion</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li4-3">verwendetes Betriebssystem</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li4-4">Referrer-URL</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li4-5">Datum und Uhrzeit des Zugriffs</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li4-6">aufgerufene Dateien oder Seiten</li>
          </ul>
          <p class="mt-3" data-ps="src/pages/datenschutzerklaerung.astro:p4-3">
            Diese Daten werden insbesondere zur technischen Bereitstellung, Fehleranalyse sowie zur Gewährleistung der Sicherheit unserer Systeme verarbeitet.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p4-4">
            Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p4-5">
            Die Logdaten werden grundsätzlich nur so lange gespeichert, wie dies für die genannten Zwecke erforderlich ist. Eine längere Speicherung kann erfolgen, wenn dies zur Untersuchung eines konkreten Sicherheitsvorfalls erforderlich ist.
          </p>
        </div>

        <!-- 5. SSL-/TLS-Verschlüsselung -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec5">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-5">
            5. SSL-/TLS-Verschlüsselung
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p5-1">
            Diese Website nutzt aus Sicherheitsgründen eine SSL- bzw. TLS-Verschlüsselung.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p5-2">
            Dadurch werden Daten, die Sie an uns übermitteln, während der Übertragung verschlüsselt.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p5-3">
            Eine verschlüsselte Verbindung erkennen Sie insbesondere an der Zeichenfolge https:// in der Adresszeile Ihres Browsers.
          </p>
        </div>

        <!-- 6. Kosten-Check und Kontaktformulare -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec6">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-6">
            6. Kosten-Check und Kontaktformulare
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p6-1">
            Auf unserer Website können Sie einen Kosten-Check durchführen und Kontaktformulare verwenden.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p6-2">
            Je nach Formular und Ihren Angaben können insbesondere folgende personenbezogene Daten verarbeitet werden:
          </p>
          <ul class="list-disc pl-5 space-y-1" data-ps="src/pages/datenschutzerklaerung.astro:ul6">
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-1">Name</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-2">E-Mail-Adresse</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-3">Telefonnummer</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-4">Postleitzahl bzw. Objektstandort</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-5">Anzahl der Wohnungen</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-6">gewünschte Rauchmelderleistungen</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-7">Angaben zu baulichen Besonderheiten</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-8">Angaben zur gewünschten Terminorganisation</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li6-9">freiwillige Nachrichten und sonstige Angaben</li>
          </ul>
          <p class="mt-3" data-ps="src/pages/datenschutzerklaerung.astro:p6-3">
            Die Verarbeitung erfolgt, um Ihre Anfrage zu bearbeiten, den gewünschten Leistungsumfang einzuschätzen, eine Kosteneinschätzung oder ein Angebot vorzubereiten und mit Ihnen Kontakt aufzunehmen.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p6-4">
            Soweit Ihre Anfrage auf den Abschluss oder die Durchführung eines Vertrages gerichtet ist, erfolgt die Verarbeitung auf Grundlage von Art. 6 Abs. 1 lit. b DSGVO.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p6-5">
            Bei sonstigen Anfragen erfolgt die Verarbeitung auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO. Unser berechtigtes Interesse besteht in der sachgerechten und effizienten Bearbeitung von Anfragen.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p6-6">
            Das Absenden des Kosten-Checks stellt keine automatische Beauftragung und keinen Vertragsschluss dar.
          </p>
        </div>

        <!-- 7. Kontaktaufnahme per E-Mail und Telefon -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec7">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-7">
            7. Kontaktaufnahme per E-Mail und Telefon
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p7-1">
            Wenn Sie uns per E-Mail oder telefonisch kontaktieren, verarbeiten wir die von Ihnen mitgeteilten Daten zur Bearbeitung Ihres Anliegens.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p7-2">
            Hierzu können insbesondere gehören:
          </p>
          <ul class="list-disc pl-5 space-y-1" data-ps="src/pages/datenschutzerklaerung.astro:ul7">
            <li data-ps="src/pages/datenschutzerklaerung.astro:li7-1">Name</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li7-2">E-Mail-Adresse</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li7-3">Telefonnummer</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li7-4">Inhalt Ihrer Anfrage</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li7-5">Angaben zum Objekt</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li7-6">Angaben zur gewünschten Dienstleistung</li>
          </ul>
          <p class="mt-3" data-ps="src/pages/datenschutzerklaerung.astro:p7-3">
            Bei vorvertraglichen oder vertraglichen Anfragen erfolgt die Verarbeitung auf Grundlage von Art. 6 Abs. 1 lit. b DSGVO.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p7-4">
            Bei sonstigen Anfragen erfolgt die Verarbeitung auf Grundlage von Art. 6 Abs. 1 lit. f DSGVO.
          </p>
        </div>

        <!-- 8. Kunden- und Auftragsdaten -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec8">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-8">
            8. Kunden- und Auftragsdaten
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p8-1">
            Wenn Sie uns mit einer Leistung beauftragen, verarbeiten wir die personenbezogenen Daten, die zur Durchführung und Abwicklung des Auftrags erforderlich sind.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p8-2">
            Hierzu können insbesondere gehören:
          </p>
          <ul class="list-disc pl-5 space-y-1" data-ps="src/pages/datenschutzerklaerung.astro:ul8">
            <li data-ps="src/pages/datenschutzerklaerung.astro:li8-1">Name und Kontaktdaten</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li8-2">Objekt- und Adressdaten</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li8-3">Terminangaben</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li8-4">Angaben zu Wohnungen und Rauchwarnmeldern</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li8-5">Prüf-, Wartungs- und Montagedaten</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li8-6">Dokumentationsdaten</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li8-7">Rechnungs- und Zahlungsdaten</li>
          </ul>
          <p class="mt-3" data-ps="src/pages/datenschutzerklaerung.astro:p8-3">
            Die Verarbeitung erfolgt insbesondere zur Angebotserstellung, Terminplanung, Leistungserbringung, Dokumentation, Kommunikation und Abrechnung.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p8-4">
            Rechtsgrundlage ist Art. 6 Abs. 1 lit. b DSGVO.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p8-5">
            Soweit gesetzliche Aufbewahrungspflichten bestehen, erfolgt die weitere Verarbeitung auf Grundlage von Art. 6 Abs. 1 lit. c DSGVO.
          </p>
        </div>

        <!-- 9. Mieter- und Bewohnerdaten -->
        <div data-ps="src/pages/datenschutzerklaerung.astro:sec9">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/datenschutzerklaerung.astro:h2-9">
            9. Mieter- und Bewohnerdaten
          </h2>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p9-1">
            Soweit uns Vermieter, Eigentümer oder Hausverwaltungen im Rahmen eines Auftrags personenbezogene Daten von Mietern oder Bewohnern zur Verfügung stellen, können insbesondere folgende Daten verarbeitet werden:
          </p>
          <ul class="list-disc pl-5 space-y-1" data-ps="src/pages/datenschutzerklaerung.astro:ul9">
            <li data-ps="src/pages/datenschutzerklaerung.astro:li9-1">Name</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li9-2">Wohnung bzw. Objektzuordnung</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li9-3">Telefonnummer</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li9-4">E-Mail-Adresse</li>
            <li data-ps="src/pages/datenschutzerklaerung.astro:li9-5">Termin- und Erreichbarkeitsinformationen</li>
          </ul>
          <p class="mt-3" data-ps="src/pages/datenschutzerklaerung.astro:p9-2">
            Die Verarbeitung erfolgt ausschließlich, soweit dies zur Terminorganisation und zur Durchführung der beauftragten Rauchmelderleistungen erforderlich ist.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p9-3">
            Die Rechtsgrundlage richtet sich nach der jeweiligen Konstellation und kann insbesondere Art. 6 Abs. 1 lit. b oder lit. f DSGVO sein.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p9-4">
            Unser berechtigtes Interesse sowie das Interesse unseres Auftraggebers bestehen in der ordnungsgemäßen und effizienten Organisation und Durchführung der beauftragten Leistungen.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p9-5">
            Die Daten werden nicht für eigene Werbezwecke verwendet.
          </p>
          <p data-ps="src/pages/datenschutzerklaerung.astro:p9-6">
            Soweit personenbezogene Daten nicht unmittelbar bei der betroffenen Person erhoben werden, beachten wir die Informationspflichten nach Art. 14 DSGVO, soweit keine gesetzliche Ausnahme eingreift.
          </p>
        </div>

        <!-- 10. Technisch notwendige Cookies und Speicherzugriffe -->
