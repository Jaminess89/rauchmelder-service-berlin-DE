---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/home/v2/HeroSection.astro';
import TrustStrip from '@/components/home/v2/TrustStrip.astro';
import ServicesSection from '@/components/home/v2/ServicesSection.astro';
import PricingContact from '@/components/home/v2/PricingContact.astro';
import CheckSection from '@/components/home/v2/CheckSection.astro';
import LandlordSection from '@/components/home/v2/LandlordSection.astro';
import ProofSection from '@/components/home/v2/ProofSection.astro';
import DutySection from '@/components/home/v2/DutySection.astro';
import ProcessSection from '@/components/home/v2/ProcessSection.astro';
import AboutSection from '@/components/home/v2/AboutSection.astro';
import DevicesSection from '@/components/home/v2/DevicesSection.astro';
import BerlinSection from '@/components/home/v2/BerlinSection.astro';
import CostsSection from '@/components/home/v2/CostsSection.astro';
import FaqSection from '@/components/home/v2/FaqSection.astro';
import FinalCta from '@/components/home/v2/FinalCta.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "MESSKLAR Rauchmelderservice",
  "description": "Rauchmelder in Berlin installieren, warten oder prüfen lassen – für Vermieter, Eigentümer und Hausverwaltungen, inklusive digitaler Dokumentation.",
  "url": SITE.url,
  "telephone": "+493092105026",
  "areaServed": [
    "Berlin",
    "Berlin-Mitte",
    "Friedrichshain-Kreuzberg",
    "Pankow",
    "Charlottenburg-Wilmersdorf",
    "Spandau",
    "Steglitz-Zehlendorf",
    "Tempelhof-Schöneberg",
    "Neukölln",
    "Treptow-Köpenick",
    "Marzahn-Hellersdorf",
    "Lichtenberg",
    "Reinickendorf"
  ],
  "openingHours": "Mo-Fr 08:00-18:30"
};
---

<BaseLayout
  title="Rauchmelderservice Berlin – Installation & Wartung | Messklar"
  description="Rauchmelder in Berlin installieren, warten oder prüfen lassen. Für Vermieter, Eigentümer & Hausverwaltungen – inklusive digitaler Dokumentation. Jetzt unverbindlich anfragen."
  jsonLd={jsonLd}
>
  <HeroSection />
  <TrustStrip />
  <ServicesSection />
  <PricingContact />
  <CheckSection />
  <LandlordSection />
  <ProofSection />
  <DutySection />
  <ProcessSection />
  <AboutSection />
  <DevicesSection />
  <BerlinSection />
  <CostsSection />
  <FaqSection />
  <FinalCta />
</BaseLayout>
