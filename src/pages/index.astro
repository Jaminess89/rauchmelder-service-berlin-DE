---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSection from '@/components/home/v2/HeroSection.astro';
import TrustStrip from '@/components/home/v2/TrustStrip.astro';
import ServicesSection from '@/components/home/v2/ServicesSection.astro';
import PricingContact from '@/components/home/v2/PricingContact.astro';
import CheckSection from '@/components/home/v2/CheckSection.astro';
import LandlordSection from '@/components/home/v2/LandlordSection.astro';
import ProofSection from '@/components/home/v2/ProofSection.astro';
import DutySection from '@/components/home/v2/DutySection.astro';
import ProcessSection from '@/components/home/v2/ProcessSection.astro';
import AboutSection from '@/components/home/v2/AboutSection.astro';
import DevicesSection from '@/components/home/v2/DevicesSection.astro';
import BerlinSection from '@/components/home/v2/BerlinSection.astro';
import CostsSection from '@/components/home/v2/CostsSection.astro';
import FaqSection from '@/components/home/v2/FaqSection.astro';
import FinalCta from '@/components/home/v2/FinalCta.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Normcheck Rauchmelderservice",
  "description": "Rauchmelder in Berlin installieren, warten oder prüfen lassen: für Vermieter, Eigentümer und Hausverwaltungen, inklusive digitaler Dokumentation.",
  "url": SITE.url,
  "telephone": "+493086328386",
  "areaServed": [
    "Berlin",
    "Berlin-Mitte",
    "Friedrichshain-Kreuzberg",
    "Pankow",
    "Charlottenburg-Wilmersdorf",
    "Spandau",
    "Steglitz-Zehlendorf",
    "Tempelhof-Schöneberg",
    "Neukölln",
    "Treptow-Köpenick",
    "Marzahn-Hellersdorf",
    "Lichtenberg",
    "Reinickendorf"
  ],
  "openingHours": "Mo-Fr 08:00-18:30"
};
---

<BaseLayout
  title="Rauchmelderservice Berlin | Installation & Wartung | Normcheck"
  description="Rauchmelder in Berlin installieren, warten oder prüfen lassen. Für Vermieter, Eigentümer & Hausverwaltungen, inklusive digitaler Dokumentation. Jetzt unverbindlich anfragen."
  jsonLd={jsonLd}
>
  <HeroSection />
  <TrustStrip />
  <ServicesSection />
  <PricingContact />
  <div class="relative overflow-hidden" data-ps="src/pages/index.astro:shared-landlord-check-bg">
    {/* Ein einziges durchgehendes Hintergrundbild für 4-Punkte-Check und Vermieter-Bereich */}
    <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true" data-ps="src/pages/index.astro:shared-bg-img">
      <picture style="display:contents">
        <source
          type="image/avif"
          srcset="/images/bg-pruefung-768.avif 768w, /images/bg-pruefung-1280.avif 1280w, /images/bg-pruefung-1536.avif 1536w"
          sizes="100vw"
        />
        <source
          type="image/webp"
          srcset="/images/bg-pruefung-768.webp 768w, /images/bg-pruefung-1280.webp 1280w, /images/bg-pruefung-1536.webp 1536w"
          sizes="100vw"
        />
        <img
          src="/images/bg-pruefung-1280.webp"
          width="1280"
          height="1415"
          alt=""
          class="w-full h-full object-cover object-center"
          loading="lazy"
          decoding="async"
          data-ps="src/pages/index.astro:shared-bg-pic"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-[#F4F8FB]/90 to-white/75 backdrop-blur-[1px]" data-ps="src/pages/index.astro:shared-bg-grad1"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-white via-transparent to-white/90" data-ps="src/pages/index.astro:shared-bg-grad2"></div>
    </div>

    <CheckSection />
    <LandlordSection />
  </div>
  <ProofSection />
  <DutySection />
  <ProcessSection />
  <AboutSection />
  <DevicesSection />
  <BerlinSection />
  <CostsSection />
  <FaqSection />
  <FinalCta />
</BaseLayout>
