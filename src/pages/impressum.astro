---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Impressum | Normcheck Rauchmelder Service Berlin",
  "description": "Impressum und rechtliche Angaben von Normcheck Rauchmelder Service Berlin.",
  "url": `${SITE.url}impressum/`
};
---

<BaseLayout
  title="Impressum | Normcheck Rauchmelder Service Berlin"
  description="Impressum und gesetzliche Anbieterkennzeichnung gemäß § 5 DDG von Normcheck Rauchmelder Service Berlin."
  jsonLd={jsonLd}
>
  <div class="bg-gradient-to-b from-[#04192b] via-[#05233d] to-[#062B4A] text-white py-14 md:py-20 border-b border-white/10" data-ps="src/pages/impressum.astro:hero">
    <Container>
      <div class="max-w-3xl mx-auto text-center" data-ps="src/pages/impressum.astro:2mj8n5">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white mb-4 tracking-tight" data-ps="src/pages/impressum.astro:h1">
          Impressum
        </h1>
        <p class="text-white/80 text-base sm:text-lg max-w-xl mx-auto" data-ps="src/pages/impressum.astro:subtitle">
          Gesetzliche Anbieterkennzeichnung gemäß § 5 Digitale-Dienste-Gesetz (DDG)
        </p>
      </div>
    </Container>
  </div>

  <section class="py-12 md:py-16 bg-white" data-ps="src/pages/impressum.astro:content">
    <Container>
      <div class="max-w-3xl mx-auto space-y-8 text-slate-700 leading-relaxed" data-ps="src/pages/impressum.astro:legal-text">
        
        <!-- Anbieter & Vertretung -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8" data-ps="src/pages/impressum.astro:box-provider">
          <h2 class="text-xl sm:text-2xl font-bold text-slate-900 mb-4 pb-2 border-b border-slate-200" data-ps="src/pages/impressum.astro:company-title">
            Angaben gemäß § 5 Digitale-Dienste-Gesetz (DDG)
          </h2>
          
          <div class="space-y-6 text-base" data-ps="src/pages/impressum.astro:provider-details">
            <div data-ps="src/pages/impressum.astro:owner-section">
              <h3 class="text-sm uppercase tracking-wider font-bold text-slate-500 mb-1" data-ps="src/pages/impressum.astro:s9ckuh">Inhaber</h3>
              <p class="text-lg font-bold text-slate-900" data-ps="src/pages/impressum.astro:ub8xth">Vladimir Povedich</p>
            </div>

            <div data-ps="src/pages/impressum.astro:address-section">
              <h3 class="text-sm uppercase tracking-wider font-bold text-slate-500 mb-1" data-ps="src/pages/impressum.astro:s9ckui">Anschrift des Diensteanbieters gemäß § 5 DDG</h3>
              <p class="text-slate-700 font-medium" data-ps="src/pages/impressum.astro:ub8xtg">Vladimir Povedich</p>
              <p class="text-slate-600" data-ps="src/pages/impressum.astro:a55gg4">Glasbläserallee 21</p>
              <p class="text-slate-600" data-ps="src/pages/impressum.astro:a55gg3">10245 Berlin</p>
              <p class="text-slate-600" data-ps="src/pages/impressum.astro:a55gg2">Deutschland</p>
            </div>

            <div data-ps="src/pages/impressum.astro:further-contact-section">
              <h3 class="text-sm uppercase tracking-wider font-bold text-slate-500 mb-1" data-ps="src/pages/impressum.astro:s9ckuj">Weitere Kontaktadresse</h3>
              <p class="text-slate-700 font-medium" data-ps="src/pages/impressum.astro:a55gg1">Rauchmelder Service Berlin Normcheck</p>
              <p class="text-slate-600" data-ps="src/pages/impressum.astro:a55gg0">c/o Salinas, Birkenstraße 4</p>
              <p class="text-slate-600" data-ps="src/pages/impressum.astro:a55gfz">13355 Berlin</p>
              <p class="text-slate-600" data-ps="src/pages/impressum.astro:a55gfy">Deutschland</p>
            </div>

            <div class="pt-4 border-t border-slate-200" data-ps="src/pages/impressum.astro:contact-block">
              <h3 class="text-sm uppercase tracking-wider font-bold text-slate-500 mb-2" data-ps="src/pages/impressum.astro:s9ckui">Direkter Kontakt</h3>
              <p class="flex flex-col sm:flex-row sm:gap-6 gap-2 text-base" data-ps="src/pages/impressum.astro:a55gfx">
                <span data-ps="src/pages/impressum.astro:ew8h7n">Telefon: <a href="tel:+493086328386" class="text-[#05233d] font-bold hover:text-[#58d21f] transition-colors" data-ps="src/pages/impressum.astro:n7b13n">030 863 28 38 6</a></span>
                <span data-ps="src/pages/impressum.astro:ew8h7o">E-Mail: <a href="mailto:info@rauchmelder-service-berlin.de" class="text-[#05233d] font-semibold hover:text-[#58d21f] transition-colors" data-ps="src/pages/impressum.astro:n7b13m">info@rauchmelder-service-berlin.de</a></span>
              </p>
            </div>
          </div>
        </div>

        <!-- Haftung für Inhalte -->
        <div data-ps="src/pages/impressum.astro:sec-haftung-inhalte">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b border-slate-200" data-ps="src/pages/impressum.astro:haftung-inhalte-heading">
            Haftung für Inhalte
          </h2>
          <p class="mb-3" data-ps="src/pages/impressum.astro:haftung-inhalte-p1">
            Die Inhalte dieser Website wurden mit größtmöglicher Sorgfalt erstellt. Für die Richtigkeit, Vollständigkeit und Aktualität der bereitgestellten Informationen kann jedoch keine Gewähr übernommen werden, soweit gesetzlich zulässig.
          </p>
          <p data-ps="src/pages/impressum.astro:haftung-inhalte-p2">
            Zwingende gesetzliche Haftungsregelungen bleiben hiervon unberührt. Sollten uns rechtswidrige oder fehlerhafte Inhalte bekannt werden, werden wir diese prüfen und erforderlichenfalls entfernen oder korrigieren.
          </p>
        </div>

        <!-- Haftung für Links -->
        <div data-ps="src/pages/impressum.astro:sec-haftung-links">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b border-slate-200" data-ps="src/pages/impressum.astro:haftung-links-heading">
            Haftung für externe Links
          </h2>
          <p class="mb-3" data-ps="src/pages/impressum.astro:haftung-links-p1">
            Diese Website kann Links zu externen Websites Dritter enthalten. Auf deren Inhalte haben wir keinen Einfluss. Für die Inhalte der verlinkten Seiten ist der jeweilige Anbieter oder Betreiber verantwortlich.
          </p>
          <p class="mb-3" data-ps="src/pages/impressum.astro:haftung-links-p2">
            Zum Zeitpunkt der Verlinkung waren für uns keine offensichtlichen Rechtsverstöße erkennbar. Eine fortlaufende Kontrolle externer Inhalte ohne konkrete Anhaltspunkte für eine Rechtsverletzung erfolgt nicht.
          </p>
          <p data-ps="src/pages/impressum.astro:haftung-links-p3">
            Sollten uns Rechtsverletzungen auf verlinkten Seiten bekannt werden, werden entsprechende Links nach Prüfung unverzüglich entfernt.
          </p>
        </div>

        <!-- Urheberrecht -->
        <div data-ps="src/pages/impressum.astro:sec-urheberrecht">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b border-slate-200" data-ps="src/pages/impressum.astro:urheberrecht-heading">
            Urheberrecht
          </h2>
          <p class="mb-3" data-ps="src/pages/impressum.astro:urheberrecht-p1">
            Die auf dieser Website erstellten Inhalte und Werke unterliegen dem deutschen Urheberrecht.
          </p>
          <p class="mb-3" data-ps="src/pages/impressum.astro:urheberrecht-p2">
            Die Vervielfältigung, Bearbeitung, Verbreitung oder sonstige Verwertung außerhalb der gesetzlichen Schranken des Urheberrechts bedarf der vorherigen Zustimmung des jeweiligen Rechteinhabers.
          </p>
          <p class="mb-3" data-ps="src/pages/impressum.astro:urheberrecht-p3">
            Soweit Inhalte auf dieser Website nicht vom Betreiber erstellt wurden, werden die Rechte Dritter beachtet und entsprechende Inhalte als solche gekennzeichnet.
          </p>
          <p data-ps="src/pages/impressum.astro:urheberrecht-p4">
            Sollten Sie auf eine mögliche Urheberrechtsverletzung aufmerksam werden, bitten wir um einen entsprechenden Hinweis. Bei Bekanntwerden einer Rechtsverletzung werden betroffene Inhalte nach Prüfung umgehend entfernt.
          </p>
        </div>

        <!-- Streitschlichtung -->
        <div data-ps="src/pages/impressum.astro:sec-streit">
          <h2 class="text-xl font-bold text-slate-900 mb-3 pb-2 border-b border-slate-200" data-ps="src/pages/impressum.astro:streit-heading">
            Verbraucherstreitbeilegung / Universalschlichtungsstelle
          </h2>
          <p data-ps="src/pages/impressum.astro:streit-p">
            Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </div>

        <!-- Bildnachweis -->
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-5" data-ps="src/pages/impressum.astro:sec-bildnachweis">
          <h2 class="text-lg font-bold text-slate-900 mb-2" data-ps="src/pages/impressum.astro:bildnachweis-heading">
            Bildnachweis
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed" data-ps="src/pages/impressum.astro:bildnachweis-p">
            Fotos & Bildquellen: Sebastian Herrmann, Lasse Diercks, Paul Lichtblau, Cecilia Miraldi sowie vvills (jeweils Unsplash) und eigene Werk- und Einsatzfotografien der Normcheck Rauchmelder Service Berlin.
          </p>
          <p class="text-sm text-slate-600 leading-relaxed mt-2">
            Hinweis: Die Namensnennung der Unsplash-Fotografinnen und -Fotografen erfolgt nach bestem Wissen auf Grundlage der Datei- und Metadaten der verwendeten Bilder. Eine abschließende Verifizierung über die Unsplash-API steht derzeit noch aus; die Angaben werden nach erfolgter Prüfung gegebenenfalls aktualisiert.
          </p>
        </div>

      </div>
    </Container>
  </section>
</BaseLayout>
