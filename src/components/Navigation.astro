---
import Container from '@/components/Container.astro';
import { SITE } from '@/config/site';
---

<style>
  /* Versteckt die Scrollbar, erhält aber die Scrollfunktion */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Logo Styles */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: transparent;
  }
  .detector-box {
    position: relative;
    width: 38px;
    height: 38px;
    shrink: 0;
  }
  .detector-box svg.detector-svg {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
  }
  .detector-box .check {
    position: absolute;
    right: -4px;
    bottom: -2px;
    width: 18px;
    height: 18px;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
  }
  .detector-box .check .mark {
    fill: url(#logo-checkGreen);
    stroke: #0a101d;
    stroke-width: 14;
    stroke-linejoin: round;
    paint-order: stroke fill;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.1;
  }
  .brand-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 16px;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .brand-subline {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #63c62f;
    text-transform: uppercase;
    white-space: nowrap;
    margin-top: 2px;
  }

  /* Scrolled State */
  #navbar.is-scrolled {
    background-color: rgba(10, 15, 25, 0.96);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
  }
</style>

<header id="navbar" class="fixed top-0 left-0 right-0 w-full z-50 bg-[#062B4A] border-b border-white/10 transition-all duration-300 shadow-md" data-ps="src/components/Navigation.astro:dt8k87">
  <nav class="h-[68px] flex items-center" data-ps="src/components/Navigation.astro:m59h3b">
    <Container class="flex justify-between items-center w-full !pl-2 sm:!pl-3 md:!pl-4">
      
      {/* Logo */}
      <a href="/" class="flex items-center no-underline shrink-0 mr-2 sm:mr-4 md:mr-6 py-2" aria-label="Rauchmelderservice Startseite" data-ps="src/components/Navigation.astro:logo-link">
        <img
          src="https://pagesmith-cdn.com/0c80a694/images/Logo_Normcheck_Rauchmelder-320-c7799d-320.webp"
          alt="Normcheck Rauchmelder Service Berlin Logo"
          class="h-8 sm:h-9 md:h-10 w-auto max-w-[170px] sm:max-w-[210px] md:max-w-[240px] object-contain"
          width="320"
          height="72"
          loading="eager"
          decoding="async"
          data-ps="src/components/Navigation.astro:logo-img"
        />
      </a>

      {/* Menu items: Single row, swipeable on mobile */}
      <div class="flex items-center overflow-x-auto no-scrollbar scroll-smooth whitespace-nowrap py-1 px-1 shrink min-w-0 w-full md:w-auto justify-between sm:justify-around md:justify-start" data-ps="src/components/Navigation.astro:gqvsdc">
        <div class="flex flex-nowrap gap-1.5 sm:gap-3 md:gap-5 lg:gap-7 items-center text-[12px] sm:text-[13px] lg:text-[14px]" data-ps="src/components/Navigation.astro:gqvsde">
          <a href="/#service" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-services">Leistungen</a>
          <a href="/#nachweis" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-duties">Protokoll</a>
          <a href="/#pflicht" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-appointments">Pflicht</a>
          <a href="/#ansprechpartner" class="px-2.5 py-1 font-bold text-white/90 uppercase no-underline hover:text-[#63c62f] transition-colors shrink-0 whitespace-nowrap" data-ps="src/components/Navigation.astro:nav-link-districts">Warum wir</a>
        </div>
      </div>

      {/* Buttons: Hidden on mobile (md breakpoint = tablet and up) */}
      <div class="hidden md:flex items-center gap-2.5 lg:gap-3.5 shrink-0 pl-3 lg:pl-6" data-ps="src/components/Navigation.astro:cta-container">
        <a 
          href="/#ersteinschaetzung" 
          class="inline-flex items-center justify-center text-white text-[13.5px] lg:text-[14.5px] font-black px-4 py-2 rounded-full no-underline transition-all duration-200 border-[1.5px] border-[rgba(103,235,66,0.9)] bg-gradient-to-b from-[rgba(49,184,54,0.75)] to-[rgba(16,137,41,0.7)] backdrop-blur-md shadow-[inset_0_1px_0_rgba(255,255,255,0.25),0_0_12px_rgba(66,230,49,0.3)] hover:brightness-110 hover:-translate-y-0.5 whitespace-nowrap"
          data-ps="src/components/Navigation.astro:green-btn">Kostenlose Anfrage</a>
        <a 
          href="tel:+493086328386" 
          class="inline-flex items-center gap-2 text-white border-[1.5px] border-[rgba(190,211,225,0.4)] bg-gradient-to-b from-[rgba(70,104,132,0.4)] to-[rgba(36,71,100,0.35)] text-[13.5px] lg:text-[14.5px] font-black px-3.5 py-1.5 rounded-full no-underline backdrop-blur-md transition-all duration-200 shadow-[inset_0_1px_rgba(255,255,255,0.12)] hover:border-[rgba(214,230,241,0.55)] hover:-translate-y-0.5 whitespace-nowrap"
          data-ps="src/components/Navigation.astro:phone-cta"
        >
          <span class="w-6 h-6 rounded-full flex items-center justify-center bg-[rgba(132,164,190,0.25)] border border-white/10 shrink-0" aria-hidden="true" data-ps="src/components/Navigation.astro:i2om6i">
            <svg viewBox="0 0 48 48" class="w-3.5 h-3.5 stroke-white fill-none" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 7 8 11c-2 2 1 11 8 19s16 12 19 10l5-6-10-7-5 5c-5-3-9-7-11-12l5-4z"/>
            </svg>
          </span>
          <span class="whitespace-nowrap" data-ps="src/components/Navigation.astro:i2om6i">030 863 28 38 6</span>
        </a>
      </div>

    </Container>
  </nav>
</header>

<script is:inline>
  const nav = document.getElementById('navbar');
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 20) {
        nav.classList.add('is-scrolled');
      } else {
        nav.classList.remove('is-scrolled');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  const NAV_GAP = 14;

  function scrollToSectionHeading(hash) {
    const id = (hash || '').replace(/^#/, '');
    if (!id) return false;
    const el = document.getElementById(id);
    if (!el) return false;
    
    // Wenn das Element selbst eine Überschrift oder die Formular-Karte ist, dieses nehmen, sonst die erste Überschrift darin
    let target = el;
    if (!el.matches('h1, h2, h3, .card')) {
      const heading = el.querySelector('h1, h2, h3');
      if (heading) target = heading;
    }
    
    const navH = nav ? nav.offsetHeight : 68;
    const top = target.getBoundingClientRect().top + window.pageYOffset - navH - NAV_GAP;
    window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
    return true;
  }

  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href]');
    if (!link) return;
    const href = link.getAttribute('href') || '';
    if (!href.includes('#')) return;
    let url;
    try { url = new URL(href, window.location.href); } catch { return; }
    if (url.pathname !== window.location.pathname) return;
    if (!url.hash) return;
    if (scrollToSectionHeading(url.hash)) {
      e.preventDefault();
      history.pushState(null, '', url.hash);
    }
  });

  window.addEventListener('load', () => {
    if (window.location.hash) {
      requestAnimationFrame(() => scrollToSectionHeading(window.location.hash));
    }
  });
</script>
