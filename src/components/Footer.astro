---
import Container from '@/components/Container.astro';

const year = new Date().getFullYear();
---

<footer class="relative bg-[#02182b] text-white pt-14 pb-8 overflow-hidden border-t border-white/10" data-ps="src/components/Footer.astro:footer">
  <!-- Subtle top highlight -->
  <div class="absolute inset-x-0 top-0 h-[1px] bg-gradient-to-r from-transparent via-white/20 to-transparent" aria-hidden="true" data-ps="src/components/Footer.astro:256hpo"></div>

  <Container class="relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 xl:gap-12 pb-12 items-start" data-ps="src/components/Footer.astro:grid">
      
      <!-- Left Column: Brand Logo + Location Map Card underneath -->
      <div class="lg:col-span-4 flex flex-col gap-6" data-ps="src/components/Footer.astro:brand-col">
        <!-- Logo -->
        <div class="flex items-center" data-ps="src/components/Footer.astro:256hpl">
          <img 
            src="https://pagesmith-cdn.com/0c80a694/images/Logo_Normcheck_Rauchmelder-320-c7799d-320.webp" 
            alt="Normcheck Rauchmelder Service Berlin" 
            class="h-9 md:h-10 w-auto object-contain brightness-0 invert"
            loading="lazy" data-ps="src/components/Footer.astro:4nfm15" />
        </div>

        <!-- Location Map Card -->
        <div class="w-full max-w-[270px] rounded-2xl border border-white/15 bg-gradient-to-b from-[#07253d] to-[#041a2e] p-3 shadow-xl overflow-hidden relative" data-ps="src/components/Footer.astro:p4vf82">
          <a 
            href="https://www.google.com/search?client=opera&hs=JDq&sca_esv=228b653b33f4aa40&biw=1390&bih=781&sxsrf=APpeQnsKHQtw6b6IjF5TiMOrGou5cvq6og:1788356040027&kgmid=/g/11nvmpxtjf&q=Normcheck+Rauchmelderservice+Installation+%26+Wartung" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="flex items-center justify-between mb-2.5 px-0.5 no-underline group"
            data-ps="src/components/Footer.astro:7gqbtj">
            <div class="flex items-center gap-2" data-ps="src/components/Footer.astro:p4vf85">
              <span class="w-2.5 h-2.5 rounded-full bg-[#63c62f] shadow-[0_0_8px_rgba(99,198,47,0.6)]" data-ps="src/components/Footer.astro:abywvl"></span>
              <div class="leading-tight" data-ps="src/components/Footer.astro:p4vf8a">
                <div class="text-[13px] font-bold text-white group-hover:text-[#63c62f] transition-colors" data-ps="src/components/Footer.astro:abywvm">Berlin und Umland</div>
                <div class="text-[10.5px] text-white/60" data-ps="src/components/Footer.astro:p4vf8b">Vor Ort für Sie da.</div>
              </div>
            </div>
            <span class="text-white/40 group-hover:text-white transition-colors text-[13px]" data-ps="src/components/Footer.astro:abywvn">›</span>
          </a>

          <!-- Map Preview Container -->
          <div class="relative w-full h-28 rounded-xl overflow-hidden border border-white/10" data-ps="src/components/Footer.astro:p4vf84">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2428.9482611775948!2d13.466349676535321!3d52.4981761378453!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47a84fd38b515e07%3A0xa0ce0592b17be836!2sMessklar%20Rauchmelderservice%20Installation%20%26%20Wartung!5e0!3m2!1sde!2sde!4v1788356149283!5m2!1sde!2sde"
              class="w-full h-full border-0 filter contrast-125 brightness-95"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Google Maps Standort von Normcheck Rauchmelderservice"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Center Columns: Leistungen & Unternehmen -->
      <div class="lg:col-span-5 grid grid-cols-2 gap-8" data-ps="src/components/Footer.astro:nav-cols">
        
        <!-- Spalte: Leistungen -->
        <div data-ps="src/components/Footer.astro:256ho0">
          <h4 class="text-[13px] font-extrabold uppercase tracking-wider text-white mb-4" data-ps="src/components/Footer.astro:2uqr69">Leistungen</h4>
          <ul class="flex flex-col gap-2.5">
            <li data-ps="src/components/Footer.astro:rb7wpt">
              <a href="/#wartung" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6je">
                <span data-ps="src/components/Footer.astro:abywtp">Prüfung und Wartung</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywtq">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wpu">
              <a href="/#service" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6jf">
                <span data-ps="src/components/Footer.astro:abywtr">Installation und Austausch</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywts">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wpv">
              <a href="/#qualitaet" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k1">
                <span data-ps="src/components/Footer.astro:abywtt">Ferninspektion</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywtu">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wpw">
              <a href="/#nachweis" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k2">
                <span data-ps="src/components/Footer.astro:abywtv">Dokumentation</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywtw">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wqi">
              <a href="/#leistungen" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k3">
                <span data-ps="src/components/Footer.astro:abywtx">Lösungen für Hausverwaltungen</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywuj">›</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Spalte: Unternehmen -->
        <div data-ps="src/components/Footer.astro:256hnz">
          <h4 class="text-[13px] font-extrabold uppercase tracking-wider text-white mb-4" data-ps="src/components/Footer.astro:2uqr6a">Unternehmen</h4>
          <ul class="flex flex-col gap-2.5">
            <li data-ps="src/components/Footer.astro:rb7wqj">
              <a href="/#ansprechpartner" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k4">
                <span data-ps="src/components/Footer.astro:abywuk">Über uns</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywul">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wqk">
              <a href="/#ablauf" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k5">
                <span data-ps="src/components/Footer.astro:abywum">Ablauf</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywun">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wql">
              <a href="/#bewertungen" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k6">
                <span data-ps="src/components/Footer.astro:abywuo">Bewertungen</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywup">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wqm">
              <a href="/#faq" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k7">
                <span data-ps="src/components/Footer.astro:abywuq">FAQ</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywur">›</span>
              </a>
            </li>
            <li data-ps="src/components/Footer.astro:rb7wqn">
              <a href="/#ersteinschaetzung" class="text-[13px] text-white/70 hover:text-white transition-colors flex items-center justify-between group" data-ps="src/components/Footer.astro:ibc6k8">
                <span data-ps="src/components/Footer.astro:abywus">Kontakt</span>
                <span class="text-white/30 group-hover:text-[#63c62f] transition-colors text-[12px]" data-ps="src/components/Footer.astro:abywve">›</span>
              </a>
            </li>
          </ul>
        </div>

      </div>

      <!-- Right Column: Kontakt -->
      <div class="lg:col-span-3 flex flex-col gap-4" data-ps="src/components/Footer.astro:right-col">
        <h4 class="text-[13px] font-extrabold uppercase tracking-wider text-white mb-1" data-ps="src/components/Footer.astro:2uqr6x">Kontakt</h4>
        
        <div class="space-y-4" data-ps="src/components/Footer.astro:256hnw">
          <!-- Phone Item -->
          <a href="tel:+493086328386" class="flex items-center gap-3.5 group no-underline text-white" data-ps="src/components/Footer.astro:7gqbth">
            <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center shrink-0 group-hover:bg-[#63c62f] group-hover:border-[#63c62f] transition-colors" data-ps="src/components/Footer.astro:256hnv">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div data-ps="src/components/Footer.astro:256hnu">
              <div class="text-[15px] font-bold group-hover:text-[#63c62f] transition-colors leading-tight" data-ps="src/components/Footer.astro:256hnt">030 863 28 38 6</div>
              <div class="text-[11px] text-white/60 mt-0.5" data-ps="src/components/Footer.astro:256hn7">Mo bis Fr von 8.00 bis 18.30 Uhr</div>
            </div>
          </a>

          <!-- Email Item -->
          <a href="mailto:vertrieb@rauchmelder-service-berlin.de" class="flex items-center gap-3.5 group no-underline text-white" data-ps="src/components/Footer.astro:7gqbti">
            <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center shrink-0 group-hover:bg-[#63c62f] group-hover:border-[#63c62f] transition-colors" data-ps="src/components/Footer.astro:256hn6">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div data-ps="src/components/Footer.astro:256hn5">
              <div class="text-[14px] font-bold group-hover:text-[#63c62f] transition-colors leading-tight" data-ps="src/components/Footer.astro:256hn4">vertrieb@rauchmelder-service-berlin.de</div>
              <div class="text-[11px] text-white/60 mt-0.5" data-ps="src/components/Footer.astro:256hn3">Wir antworten i. d. R. innerhalb 24h.</div>
            </div>
          </a>

          <!-- Location Item -->
          <div class="flex items-center gap-3.5" data-ps="src/components/Footer.astro:256hn2">
            <div class="w-10 h-10 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center shrink-0" data-ps="src/components/Footer.astro:256hn1">
              <svg class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div data-ps="src/components/Footer.astro:256hn0">
              <div class="text-[14px] font-bold text-white leading-tight" data-ps="src/components/Footer.astro:256hmz">Berlin und Umland</div>
              <div class="text-[11px] text-white/60 mt-0.5" data-ps="src/components/Footer.astro:256hmy">Vor Ort für Sie da.</div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- Bottom Bar / Legal Links, Disclaimer & Copyright -->
    <div class="border-t border-white/10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-white/60 text-[12px]" data-ps="src/components/Footer.astro:bottom">
      <div class="flex items-center gap-4" data-ps="src/components/Footer.astro:p4vf86">
        <span data-ps="src/components/Footer.astro:hzwfpc">© 2026 Normcheck. Alle Rechte vorbehalten.</span>
      </div>

      <!-- Center Legal Links -->
      <div class="flex items-center gap-6 text-[12px]" data-ps="src/components/Footer.astro:legal-links">
        <a href="/impressum/" class="text-white/70 hover:text-white transition-colors" data-ps="src/components/Footer.astro:ibc6k9">Impressum</a>
        <span class="w-[1px] h-3 bg-white/20" aria-hidden="true" data-ps="src/components/Footer.astro:hzwfpb"></span>
        <a href="/datenschutzerklaerung/" class="text-white/70 hover:text-white transition-colors" data-ps="src/components/Footer.astro:ibc6ka">Datenschutz</a>
      </div>

      <!-- Right Disclaimer Text -->
      <div class="text-[11px] text-white/50 text-center md:text-right max-w-sm" data-ps="src/components/Footer.astro:csf7a">
        Rechtliche Angaben dienen der allgemeinen Information und ersetzen keine Rechtsberatung.
      </div>
    </div>
  </Container>
</footer>
