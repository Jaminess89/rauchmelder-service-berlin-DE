<style>
.mkc,.mkc *{box-sizing:border-box}
.mkc{
  --b:#087bff;
  --g:#46c92a;
  position:relative;
  overflow:hidden;
  padding:56px 0 48px;
  font-family:Inter,Arial,sans-serif;
  background:#06233d;
  color:#fff;
}
.bg-layer{
  position:absolute;
  inset:0;
  z-index:0;
  pointer-events:none;
}
.bg-img{
  width:100%;
  height:100%;
  object-fit:cover;
  object-position:center 30%;
}
.bg-overlay{
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg, rgba(6,28,55,0.38) 0%, rgba(8,42,78,0.28) 42%, rgba(4,22,44,0.55) 100%),
    radial-gradient(ellipse 70% 55% at 50% 18%, rgba(10,55,110,0.22) 0%, transparent 70%);
}
.head{
  position:relative;
  z-index:2;
  max-width:920px;
  margin:0 auto 8px;
  padding:18px 22px 8px;
  isolation:isolate;
}
.head:before{
  content:"";
  position:absolute;
  z-index:-1;
  left:8%;
  right:8%;
  top:6%;
  bottom:18%;
  border-radius:40px;
  background:rgba(6,28,55,0.28);
  filter:blur(18px);
}
.in{
  position:relative;
  z-index:2;
  width:100%;
  max-width:1500px;
  margin-inline:auto;
  padding-inline:20px;
}
@media(min-width:768px){.in{padding-inline:60px}}
@media(min-width:1280px){.in{padding-inline:115px}}

.tag{
  width:max-content;
  margin:0 auto 16px;
  padding:8px 22px;
  border:1px solid rgba(56,189,248,0.45);
  background:rgba(6,35,61,0.65);
  backdrop-filter:blur(6px);
  border-radius:99px;
  font-size:clamp(11px,1vw,14px);
  font-weight:800;
  letter-spacing:0.08em;
  color:#60a5fa;
}
.mkc h2{
  text-align:center;
  font-size:clamp(38px,5vw,72px);
  line-height:1.03;
  font-weight:900;
  text-shadow:0 4px 20px rgba(0,0,0,0.4);
}
.mkc h2 span,.sub b,.blue h3 span{color:var(--b)}
.sub{
  max-width:760px;
  margin:15px auto 43px;
  text-align:center;
  color:#dce3ed;
  font-size:clamp(15px,1.4vw,20px);
  text-shadow:0 2px 10px rgba(0,0,0,0.5);
}
.grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:clamp(18px,2.4vw,38px);
}
.card{
  position:relative;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  border:1px solid #5184c68c;
  border-radius:18px;
  background:#fff;
  box-shadow:0 18px 45px rgba(0,0,0,0.35);
}
.card:after{
  content:"";
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  height:5px;
  background:#1268ff;
}
.green{border-color:#49c31c88}
.green:after{background:var(--g)}
.top{
  position:relative;
  display:flex;
  flex-direction:column;
  align-items:center;
  min-height:235px;
  padding:22px 22px 52px;
  text-align:center;
  background:radial-gradient(circle at 50% 0,#186bcf38,transparent 52%),linear-gradient(155deg,#082b55,#031b3d 53%,#01152f);
}
.top:after{
  content:"";
  position:absolute;
  z-index:1;
  left:-10%;
  right:-10%;
  bottom:-31px;
  height:63px;
  background:#fff;
  border-radius:50% 50% 0 0/45% 45% 0 0;
}
.orb{
  position:relative;
  z-index:3;
  width:clamp(78px,6.3vw,98px);
  aspect-ratio:1;
  margin-bottom:14px;
  display:grid;
  place-items:center;
  border-radius:50%;
  color:#fff;
  border:1.5px solid #319cff;
  background:radial-gradient(circle at 40% 33%,#3099ff,#0758d5 50%,#043582);
}
.green .orb{
  width:clamp(80px,6.6vw,102px);
  border-color:#5de968;
  background:radial-gradient(circle at 38% 30%,#35be4b,#108634 44%,#045829 73%,#023b20);
}
.orb svg{
  width:58%;
  height:58%;
  fill:none;
  stroke:currentColor;
  stroke-width:4;
  stroke-linecap:round;
  stroke-linejoin:round;
}
.top h3{
  position:relative;
  z-index:3;
  margin:0 0 7px;
  font-size:clamp(21px,1.75vw,27px);
  line-height:1.12;
  font-weight:900;
}
.green h3 span{color:#54d62a}
.top p{
  position:relative;
  z-index:3;
  margin:0;
  color:#dce3ee;
  font-size:clamp(13px,1.1vw,16px);
  line-height:1.4;
}
.body{
  position:relative;
  z-index:3;
  flex:1;
  padding:34px clamp(22px,3vw,40px);
}
.body ul{
  display:grid;
  gap:18px;
  margin:0;
  padding:0;
  list-style:none;
}
.body li{
  display:grid;
  grid-template-columns:20px minmax(0,1fr);
  gap:12px;
  color:#0a2c59;
  font-size:clamp(14px,1.1vw,16px);
  line-height:1.36;
}
.body li:before{
  content:"✓";
  width:20px;
  height:20px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#0978ef;
  color:#fff;
  font-size:12px;
  font-weight:900;
}
.green .body li:before{background:#39ae19}

@media(max-width:1100px){
  .grid{
    grid-template-columns:repeat(2,minmax(0,1fr));
    max-width:900px;
    margin:auto;
  }
  .card:nth-child(3){
    grid-column:1/-1;
    width:min(100%,441px);
    justify-self:center;
  }
}

@media(max-width:700px){
  .mkc{padding:36px 0 32px}
  .mkc h2{font-size:clamp(34px,10vw,46px)}
  .sub{margin-bottom:28px}
  .grid{
    grid-template-columns:1fr;
    max-width:520px;
    gap:18px;
  }
  .card:nth-child(3){
    grid-column:auto;
    width:100%;
  }
  .top{
    min-height:0;
    padding:22px 18px 48px;
  }
  .top h3{
    max-width:340px;
    margin-inline:auto;
    font-size:clamp(22px,6.4vw,27px);
  }
  .top p{max-width:340px}
  .body{padding:30px 22px 31px}
  .body li{font-size:15px}
}
</style>
