<section class="doc" id="nachweis" data-ps="src/components/home/v2/ProofSection.astro:doc-sec">
<style>
.doc{
  --n:#07284b;
  --g:#55c72f;
  --mut:#60718a;
  --line:#dce4ec;
  --bg:#f7f5ef;
  font-family:Arial,sans-serif;
  color:var(--n);
  background-color:var(--bg);
  background-image:radial-gradient(#d3cbbd 0.75px, transparent 0.75px), radial-gradient(#d3cbbd 0.75px, var(--bg) 0.75px);
  background-size:20px 20px;
  background-position:0 0, 10px 10px;
  padding:58px 4%;
  position:relative;
  overflow:hidden;
}
.wrap{max-width:1200px;margin:auto;display:flex;flex-direction:column;gap:36px;position:relative;z-index:1}
.header-area{max-width:850px}
.kicker{font-weight:700;letter-spacing:4px;color:#355375;font-size:15px;text-transform:uppercase;display:flex;align-items:center;gap:16px}
.kicker:before{content:"";width:48px;height:3px;background:#e2ab5b;border-radius:9px}
h2{font-size:clamp(36px,4vw,56px);line-height:1.08;margin:20px 0 16px;letter-spacing:-1.5px}
.lead{font-size:20px;line-height:1.45;color:var(--mut);margin:0}
.trust{color:#8496ab;font-size:13px;letter-spacing:2px;font-weight:700;display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;text-align:center;margin-top:4px}
.panel{background:#fff;border:1px solid #d8e1e9;border-radius:24px;padding:32px;box-shadow:0 12px 30px #0b22380a;width:100%}
.phead{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:24px}
.phead h3{font-size:31px;margin:0;letter-spacing:-1px}
.tag{background:#f4ead8;color:#9a7137;padding:12px 20px;border-radius:30px;font-weight:800}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:26px}
.stat{background:#f6f9fc;border:1px solid #dce5ed;border-radius:15px;padding:17px}
.stat small{display:block;color:#65758c;letter-spacing:1.5px;font-weight:800;margin:0 0 8px}
.stat strong{font-size:20px}
.table{border:1px solid var(--line);border-radius:16px;overflow:hidden}
.row{display:grid;grid-template-columns:1.05fr 1.1fr 1.1fr .9fr;align-items:center;min-height:56px;padding:0 22px;border-top:1px solid var(--line);font-size:17px}
.row:first-child{border:0;background:#082e54;color:white;min-height:54px;font-size:14px;letter-spacing:1.3px;font-weight:800}
.room{font-weight:800}.state{font-weight:800}
.dot{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:9px;background:#22b45b}
.warn{color:#bf4d00}.warn .dot{background:#f39a00}
.foot{margin-top:18px;background:#f2f6f9;border-radius:14px;padding:15px 17px;display:flex;justify-content:space-between;align-items:center;gap:20px;color:#6b7c91}
.footinfo{display:flex;align-items:center;gap:10px;line-height:1.35}
.info{width:27px;height:27px;border-radius:50%;background:#71839b;color:#fff;display:grid;place-items:center;font-weight:800;flex:none}
.cta{display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,#0c3866,#07284b);color:#fff;text-decoration:none;font-weight:800;font-size:16px;padding:14px 22px;border-radius:12px;border:1px solid #1c4b7e;white-space:nowrap;box-shadow:0 8px 20px rgba(7,40,75,0.22);transition:all .2s ease;cursor:pointer}
.cta:hover{transform:translateY(-2px);background:linear-gradient(135deg,#124982,#0a335f);box-shadow:0 12px 26px rgba(7,40,75,0.32);border-color:#3878bd}
.cta svg{width:20px;height:20px;stroke:#58d21f;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;transition:.2s}
.cta:hover svg{stroke:#72ea3b;transform:scale(1.08)}

/* Modal Styles (Downloadgeschützte Vorschau) */
.proto-modal{position:fixed;inset:0;z-index:9999;background:rgba(4,18,34,0.88);backdrop-filter:blur(8px);display:none;align-items:center;justify-content:center;padding:16px;opacity:0;transition:opacity .25s ease;user-select:none;-webkit-user-select:none}
.proto-modal.is-open{display:flex;opacity:1}
.proto-modal__box{position:relative;width:100%;max-width:920px;height:92vh;max-height:940px;background:#eef2f6;border-radius:20px;box-shadow:0 24px 60px rgba(0,0,0,0.55);display:flex;flex-direction:column;overflow:hidden;border:1px solid rgba(255,255,255,0.2);animation:popIn .25s ease-out}
@keyframes popIn{from{transform:scale(.96);opacity:0}to{transform:scale(1);opacity:1}}
.proto-modal__header{display:flex;align-items:center;justify-content:space-between;padding:6px 14px;background:#07284b;color:#fff;border-bottom:1px solid #0d3864;flex-shrink:0}
.proto-modal__title{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600;opacity:0.9}
.proto-modal__title svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2}
.proto-modal__badge{background:rgba(88,210,31,0.15);color:#58d21f;border:1px solid rgba(88,210,31,0.3);font-size:10px;font-weight:700;padding:2px 6px;border-radius:4px;letter-spacing:0.3px}
.proto-modal__close{background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);color:#fff;width:26px;height:26px;border-radius:50%;display:grid;place-items:center;cursor:pointer;transition:.2s}
.proto-modal__close:hover{background:#ff4d4f;border-color:#ff4d4f;transform:rotate(90deg)}
.proto-modal__close svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2.5}
.proto-modal__body{flex:1;background:#505761;position:relative;overflow-y:auto;overflow-x:hidden;padding:12px 14px 20px;display:flex;flex-direction:column;align-items:center;gap:18px}

/* Page document styles */
.doc-page{position:relative;width:100%;max-width:780px;background:#fff;border-radius:4px;box-shadow:0 10px 30px rgba(0,0,0,0.35);padding:36px 36px 28px;color:#1e293b;font-family:system-ui,-apple-system,sans-serif;font-size:12px;line-height:1.4}
.doc-page__wm{position:absolute;inset:0;display:grid;place-items:center;pointer-events:none;overflow:hidden}
.doc-page__wm span{font-size:110px;font-weight:900;color:rgba(15,23,42,0.025);transform:rotate(-30deg);letter-spacing:14px;text-transform:uppercase}
.doc-header{display:flex;justify-content:space-between;align-items:flex-start;border-bottom:3px solid #07284b;padding-bottom:14px;margin-bottom:18px;gap:16px}
.doc-logo-img{height:34px;width:auto;object-fit:contain}
.doc-header__title{text-align:right}
.doc-header__title h4{font-size:19px;font-weight:800;color:#07284b;margin:0 0 3px}
.doc-header__title p{font-size:11px;color:#64748b;margin:0}
.doc-tag{display:inline-block;background:#07284b;color:#58d21f;font-size:9.5px;font-weight:800;letter-spacing:1px;padding:3px 8px;border-radius:4px;margin-top:5px}

.sec-head{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:800;color:#07284b;margin:16px 0 8px}
.sec-num{background:#07284b;color:#fff;width:20px;height:20px;border-radius:4px;display:grid;place-items:center;font-size:10.5px}
.grid-2col{display:grid;grid-template-columns:1fr 1fr;gap:10px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px}
.kv-item{display:flex;justify-content:space-between;font-size:11px;padding:2px 0;border-bottom:1px dashed #e2e8f0}
.kv-item:last-child{border-bottom:0}
.kv-label{color:#64748b}
.kv-val{font-weight:700;color:#0f172a;text-align:right}

.stat-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:14px 0}
.stat-box{background:#f1f5f9;border:1px solid #cbd5e1;border-radius:6px;padding:8px 10px;text-align:center}
.stat-box strong{display:block;font-size:18px;color:#07284b;font-weight:900}
.stat-box span{font-size:10px;color:#64748b;font-weight:700}

.dtable{width:100%;border-collapse:collapse;margin:10px 0;font-size:11px;border:1px solid #cbd5e1;border-radius:6px;overflow:hidden}
.dtable th{background:#07284b;color:#fff;padding:6px 8px;font-size:10px;font-weight:700;text-align:left}
.dtable td{padding:6px 8px;border-top:1px solid #e2e8f0;color:#334155}
.dtable tr:nth-child(even){background:#f8fafc}
.status-pill{display:inline-block;padding:2px 6px;border-radius:4px;font-weight:800;font-size:10px}
.status-pill.ok{background:#dcfce7;color:#15803d}
.status-pill.neu{background:#e0f2fe;color:#0369a1}

.check-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.check-card{background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:8px 10px}
.check-card strong{color:#07284b;font-size:11px;display:flex;align-items:center;gap:5px}
.check-card p{font-size:10px;color:#64748b;margin:3px 0 0}

.sum-box{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;padding:12px;display:flex;gap:10px;align-items:flex-start;margin-top:12px}
.sum-box svg{width:20px;height:20px;stroke:#16a34a;flex-shrink:0}
.sum-box strong{display:block;font-size:11.5px;color:#15803d;margin-bottom:2px}
.sum-box p{font-size:10.5px;color:#334155;margin:0}

.sig-area{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:18px;padding-top:14px;border-top:1px dashed #cbd5e1}
.sig-box{border:1px solid #e2e8f0;border-radius:6px;padding:10px;background:#fafafa}
.sig-box small{color:#64748b;font-size:9.5px;font-weight:700;text-transform:uppercase;display:block}
.sig-box .name{font-weight:800;color:#07284b;font-size:12px;margin:3px 0 10px}
.sig-line{height:1px;background:#94a3b8;margin-top:14px}
.sig-caption{font-size:9px;color:#94a3b8;margin-top:3px}

.doc-footer{display:flex;justify-content:space-between;font-size:9.5px;color:#94a3b8;border-top:1px solid #e2e8f0;padding-top:10px;margin-top:18px}
.note{text-align:right;font:italic 19px Georgia,serif;color:#7c8ba0;margin:16px 28px 0 0}
@media(max-width:980px){
.doc{padding:38px 18px}.wrap{gap:28px}
h2{font-size:38px}.lead{font-size:18px}.panel{padding:20px}
.stats{grid-template-columns:1fr 1fr}.table{overflow-x:auto}
.row{min-width:760px}.note{display:none}
}
@media(max-width:560px){
h2{font-size:32px}
.panel{padding:15px}.phead{align-items:flex-start}.phead h3{font-size:22px}
.tag{font-size:12px;padding:9px 13px}.stat{padding:14px}
.foot{flex-direction:column;align-items:stretch}.cta{width:100%}
.trust{line-height:1.6;font-size:12px}
}
</style>

