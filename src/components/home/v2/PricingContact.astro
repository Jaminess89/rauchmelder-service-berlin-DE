---
/**
 * Pricing & Inquiry Section - "Jetzt Angebot anfragen" with wow-bg background
 */
---

<section class="relative overflow-hidden py-8 md:py-14 bg-[#062B4A]" aria-labelledby="offer-heading" data-ps="src/components/home/v2/PricingContact.astro:ksll70">
  <!-- Hintergrundbild mit performantem Blur & abgedunkeltem Overlay (ohne ruckelnden backdrop-filter) -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none" aria-hidden="true" data-ps="src/components/home/v2/PricingContact.astro:hciiwo">
    <img
      src="https://pagesmith-cdn.com/0c80a694/images/lasse-diercks-VrLHlLNVw7M-unsplash-1024-7fc208-1024.webp"
      srcset="https://pagesmith-cdn.com/0c80a694/images/lasse-diercks-VrLHlLNVw7M-unsplash-1024-7fc208-320.webp 320w, https://pagesmith-cdn.com/0c80a694/images/lasse-diercks-VrLHlLNVw7M-unsplash-1024-7fc208-640.webp 640w, https://pagesmith-cdn.com/0c80a694/images/lasse-diercks-VrLHlLNVw7M-unsplash-1024-7fc208-768.webp 768w, https://pagesmith-cdn.com/0c80a694/images/lasse-diercks-VrLHlLNVw7M-unsplash-1024-7fc208-1024.webp 1024w"
      sizes="100vw"
      alt="Wohnung in Berlin"
      class="w-full h-full object-cover object-center scale-110 blur-[8px] transform-gpu"
      loading="lazy" data-ps="src/components/home/v2/PricingContact.astro:ciqfql" />
    <div class="absolute inset-0 bg-[#062B4A]/70" data-ps="src/components/home/v2/PricingContact.astro:hciiwp"></div>
    {/* Sanfter 35% Übergang oben von ServicesSection */}
    <div class="absolute inset-x-0 top-0 h-[35%] pointer-events-none z-[1] bg-gradient-to-b from-[#062B4A] to-transparent" aria-hidden="true" data-ps="src/components/home/v2/PricingContact.astro:trans-top"></div>
  </div>

  <div class="wow-content relative z-10" data-ps="src/components/home/v2/PricingContact.astro:hciiwp">
    <div id="ersteinschaetzung" class="card scroll-mt-[68px]" data-ps="src/components/home/v2/PricingContact.astro:card">
      <div class="trust" data-ps="src/components/home/v2/PricingContact.astro:trust">
        <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3 26 7v8c0 6.4-3.8 11.1-10 14C9.8 26.1 6 21.4 6 15V7Z"/><path d="m11.3 16 3.2 3.2 6.5-7"/></svg>
        <span data-ps="src/components/home/v2/PricingContact.astro:6zho5x">KOSTENLOS</span><i></i><span data-ps="src/components/home/v2/PricingContact.astro:6zho5w">UNVERBINDLICH</span><i></i><span data-ps="src/components/home/v2/PricingContact.astro:6zho5v">PERSÖNLICHE RÜCKMELDUNG</span>
      </div>
      
      <h2 id="offer-heading" data-ps="src/components/home/v2/PricingContact.astro:h2">Jetzt <span data-ps="src/components/home/v2/PricingContact.astro:6zho5u">Angebot</span> anfragen</h2>
      <p class="lead" data-ps="src/components/home/v2/PricingContact.astro:lead">3 kurze Angaben reichen. Wir melden uns persönlich mit einer Einschätzung.</p>
      
      <form id="offer-form" novalidate data-ps="src/components/home/v2/PricingContact.astro:form">
        <input type="hidden" name="_formId" value="kostenloses-angebot" />
        
        <label data-ps="src/components/home/v2/PricingContact.astro:3254ue">Was benötigen Sie?</label>
        <div class="choices" data-ps="src/components/home/v2/PricingContact.astro:hciiwi">
          <label class="choice" data-ps="src/components/home/v2/PricingContact.astro:3254ud">
            <input type="radio" name="art" value="Installation" checked />
            <svg class="install" viewBox="0 0 32 32"><path d="M22.8 5.1a7.1 7.1 0 0 0-8.6 9L5.1 23.2a3.4 3.4 0 0 0 4.8 4.8l9.1-9.1a7.1 7.1 0 0 0 9-8.6l-5 5-4.4-1.2-1.2-4.4Z"/><circle cx="7.6" cy="25.5" r="1.3"/></svg>
            <b>Installation</b>
          </label>
          <label class="choice" data-ps="src/components/home/v2/PricingContact.astro:3254uc">
            <input type="radio" name="art" value="Wartung / Prüfung" />
            <svg viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M8 3v4M16 3v4M4 9h16M8 13h2M14 13h2M8 16h2M14 16h2"/></svg>
            <b>Wartung / Prüfung</b>
          </label>
          <label class="choice" data-ps="src/components/home/v2/PricingContact.astro:3254ub">
            <input type="radio" name="art" value="Noch unsicher" />
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M9.8 9a2.4 2.4 0 1 1 3.7 2c-1 .6-1.5 1.1-1.5 2.2M12 17h.01"/></svg>
            <b>Noch unsicher</b>
          </label>
        </div>

        <label for="offer-size" data-ps="src/components/home/v2/PricingContact.astro:3254ua">Wie groß ist das Objekt?</label>
        <select id="offer-size" name="objektgroesse">
          <option value="">Bitte auswählen</option>
          <option value="1 Wohnung">1 Wohnung</option>
          <option value="2-5 Wohnungen">2-5 Wohnungen</option>
          <option value="6-20 Wohnungen">6-20 Wohnungen</option>
          <option value="Mehr als 20 Wohnungen">Mehr als 20 Wohnungen</option>
        </select>

        <label for="offer-bezirk" data-ps="src/components/home/v2/PricingContact.astro:3254u9">Bezirk oder PLZ</label>
        <div class="field" data-ps="src/components/home/v2/PricingContact.astro:hciiwj">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s6-5 6-11a6 6 0 1 0-12 0c0 6 6 11 6 11Z"/><circle cx="12" cy="10" r="2"/></svg>
          <input id="offer-bezirk" name="bezirk" placeholder="z. B. Neukölln oder 12043" autocomplete="address-level2" />
        </div>

        <div class="twocol" data-ps="src/components/home/v2/PricingContact.astro:hciiwk">
          <div data-ps="src/components/home/v2/PricingContact.astro:hciiwl">
            <label for="offer-email" data-ps="src/components/home/v2/PricingContact.astro:3254tn">E-Mail *</label>
            <div class="field" data-ps="src/components/home/v2/PricingContact.astro:hciiwm">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
              <input id="offer-email" type="email" name="email" required autocomplete="email" placeholder="Ihre E-Mail-Adresse" />
            </div>
          </div>
          <div data-ps="src/components/home/v2/PricingContact.astro:hciiwn">
            <label for="offer-phone" data-ps="src/components/home/v2/PricingContact.astro:3254tm">Telefon (optional)</label>
            <div class="field" data-ps="src/components/home/v2/PricingContact.astro:hciiwo">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h4l2 5-3 2c1 3 3 5 6 6l2-3 5 2v4c0 1-1 2-2 2C10 21 3 14 3 5c0-1 1-2 2-2Z"/></svg>
              <input id="offer-phone" type="tel" name="telefon" autocomplete="tel" placeholder="Für Rückfragen" />
            </div>
          </div>
        </div>

        <label for="offer-message" data-ps="src/components/home/v2/PricingContact.astro:3254tl">Beschreibung / Ergänzung (optional)</label>
        <textarea id="offer-message" name="nachricht" placeholder="Zum Beispiel besondere Anforderungen, Objektart oder gewünschter Termin ..."></textarea>

        <div id="offer-status-error" class="hidden text-[14px] font-bold text-[#b3362e] bg-[#fdf0ef] border border-[#f2c9c5] rounded-xl px-4 py-3" role="alert" data-ps="src/components/home/v2/PricingContact.astro:hciiwp"></div>

        <button type="submit" id="offer-submit-btn" class="offer-btn cursor-pointer" data-ps="src/components/home/v2/PricingContact.astro:lu0dnu">
          Kostenloses Angebot anfragen <span data-ps="src/components/home/v2/PricingContact.astro:6zho5t">→</span>
        </button>
        
        <small>Kostenlos · unverbindlich · persönliche Rückmeldung</small>
      </form>

      <!-- Erfolgs-Meldung -->
      <div id="offer-success" class="hidden flex flex-col items-center text-center py-10" data-ps="src/components/home/v2/PricingContact.astro:success">
        <span class="flex items-center justify-center w-16 h-16 rounded-full bg-[#EAF6E4] border-2 border-[#16b64c] mb-5" aria-hidden="true" data-ps="src/components/home/v2/PricingContact.astro:6zho5s">
          <svg class="w-8 h-8 text-[#11a744]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
        </span>
        <h3 class="text-[26px] font-black text-[#061f45] mb-2 mt-0" data-ps="src/components/home/v2/PricingContact.astro:922j09">Vielen Dank für Ihre Anfrage!</h3>
        <p class="text-[16px] text-[#536b8c] max-w-lg mb-6 leading-relaxed" data-ps="src/components/home/v2/PricingContact.astro:zx8aa">
          Wir haben Ihre Angaben erhalten und prüfen diese sorgfältig. Sie erhalten in Kürze eine persönliche Einschätzung von uns.
        </p>
        <button type="button" id="offer-reset-btn" class="inline-flex items-center gap-2 bg-[#061f45] hover:bg-[#0b2d63] text-white text-[15px] font-bold px-6 py-3 rounded-xl transition-colors cursor-pointer" data-ps="src/components/home/v2/PricingContact.astro:t2zd5r">
          Weitere Anfrage senden
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  * {
    box-sizing: border-box;
  }
  .wow-content {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1500px;
    margin-inline: auto;
    padding-inline: 20px;
    padding-top: 20px;
    padding-bottom: 30px;
  }
  @media (min-width: 768px) {
    .wow-content {
      padding-inline: 60px;
      padding-top: 32px;
      padding-bottom: 40px;
    }
  }
  @media (min-width: 1280px) {
    .wow-content {
      padding-inline: 115px;
      padding-top: 36px;
      padding-bottom: 48px;
    }
  }
  .card {
    width: 100%;
    max-width: 65%;
    margin: auto;
    padding: 26px 32px 24px;
    border-radius: 20px;
    background: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 20px 60px rgba(7, 24, 45, 0.25);
  }
  @media (max-width: 1024px) {
    .card {
      max-width: 80%;
    }
  }
  @media (max-width: 760px) {
    .card {
      max-width: 100%;
      padding: 20px 16px;
      border-radius: 16px;
    }
  }
  .trust {
    width: fit-content;
    max-width: 100%;
    margin: 0 auto 12px;
    min-height: 34px;
    padding: 6px 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, #edf9f2, #e7f8ef);
    border: 1px solid #d4f2e0;
    font-size: 12px;
    line-height: 1.2;
    font-weight: 800;
    color: #08274e;
    letter-spacing: 0.02em;
    text-align: center;
  }
  .trust svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    fill: none;
    stroke: #11a744;
    stroke-width: 2.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .trust i {
    width: 3.5px;
    height: 3.5px;
    flex: 0 0 3.5px;
    border-radius: 50%;
    background: #14a845;
  }
  .trust span {
    white-space: nowrap;
  }
  .card h2 {
    margin: 12px 0 3px;
    text-align: center;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.1;
    font-weight: 900;
    letter-spacing: -1.5px;
    color: #061f45;
  }
  .card h2 span {
    position: relative;
    color: #0aa83f;
  }
  .card h2 span:after {
    content: "";
    position: absolute;
    left: 2%;
    right: 2%;
    bottom: -5px;
    height: 3.5px;
    border-radius: 50%;
    background: linear-gradient(90deg, transparent, #16b64c 14% 86%, transparent);
    transform: rotate(-2deg);
  }
  .lead {
    margin: 8px auto 22px;
    text-align: center;
    font-size: clamp(14px, 1.4vw, 17px);
    color: #536b8c;
  }
  form {
    display: grid;
    gap: 10px;
  }
  form > label, .twocol label {
    font-size: 14.5px;
    font-weight: 800;
    color: #082b53;
  }
  .choices {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .choice {
    min-height: 72px;
    border: 1px solid #bdd2eb;
    border-radius: 9px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    cursor: pointer;
    background: #fff;
    color: #0b2d63;
    padding: 6px 4px;
    transition: .15s ease-out;
  }
  .choice input {
    display: none;
  }
  .choice svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .choice .install {
    width: 24px;
    height: 24px;
    stroke-width: 2.25;
  }
  .choice b {
    font-size: 14px;
  }
  .choice:has(input:checked) {
    border: 1.6px solid #17ae4b;
    background: radial-gradient(circle at 50% 0, #2fca5b14, transparent 62%), linear-gradient(135deg, #fbfffc, #eefbf2);
    color: #0ba63f;
    box-shadow: 0 4px 14px #0fa74114, inset 0 0 0 1px #ffffffb3;
  }
  .choice:hover {
    transform: translateY(-1px);
  }
  select, .field, textarea {
    width: 100%;
    border: 1px solid #bed3eb;
    border-radius: 9px;
    background: #fff;
    min-height: 46px;
    color: #31547c;
    font: 500 15px Inter, Arial, sans-serif;
    transition: .15s ease-out;
  }
  select:focus, .field:focus-within, textarea:focus {
    outline: none;
    border-color: #42a86b;
    box-shadow: 0 0 0 3px #25ad4f14;
  }
  select {
    padding: 0 12px;
  }
  .field {
    display: flex;
    align-items: center;
    padding: 0 12px;
  }
  .field svg {
    flex: 0 0 20px;
    width: 20px;
    height: 20px;
    margin-right: 10px;
    fill: none;
    stroke: #5c7da8;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .field input {
    width: 100%;
    border: 0;
    outline: 0;
    font: 500 15px Inter, Arial, sans-serif;
    color: #27496f;
    background: transparent;
  }
  .field input::placeholder, textarea::placeholder {
    color: #6f8bad;
  }
  .twocol {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .twocol > div {
    display: grid;
    gap: 6px;
  }
  textarea {
    min-height: 64px;
    padding: 10px 12px;
    resize: vertical;
  }
  button.offer-btn {
    margin-top: 4px;
    min-height: 52px;
    border: 0;
    border-radius: 9px;
    background: linear-gradient(135deg, #12a93f, #08b843);
    color: #fff;
    font-size: 16.5px;
    font-weight: 900;
    box-shadow: 0 10px 22px #0aac3f38;
    cursor: pointer;
    transition: .15s ease-out;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  button.offer-btn span {
    margin-left: 10px;
    font-size: 22px;
  }
  button.offer-btn:hover {
    filter: brightness(1.05);
    transform: translateY(-1px);
    box-shadow: 0 14px 28px #0aac3f47;
  }
  small {
    text-align: center;
    color: #597393;
    font-size: 13px;
  }
  @media (max-width: 760px) {
    .trust {
      width: fit-content;
      max-width: 100%;
      gap: 4px 8px;
      padding: 6px 12px;
      font-size: 11px;
    }
    .trust svg {
      width: 15px;
      height: 15px;
      flex-basis: 15px;
    }
  }
  @media (max-width: 440px) {
    .trust {
      gap: 4px 6px;
      padding: 5px 10px;
      font-size: 9.5px;
      letter-spacing: 0.01em;
    }
    .trust svg {
      width: 14px;
      height: 14px;
      flex-basis: 14px;
    }
    .card h2 {
      font-size: clamp(26px, 8vw, 36px);
      letter-spacing: -1px;
    }
    .lead {
      margin-bottom: 18px;
      font-size: 14.5px;
    }
    .choices {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .choice {
      min-height: 54px;
      flex-direction: row;
      gap: 8px;
    }
    .twocol {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('offer-form');
    const errorEl = document.getElementById('offer-status-error');
    const successEl = document.getElementById('offer-success');
    const submitBtn = document.getElementById('offer-submit-btn');
    const resetBtn = document.getElementById('offer-reset-btn');

    if (!form) return;

    const showError = (msg, input) => {
      if (errorEl) {
        errorEl.textContent = msg;
        errorEl.classList.remove('hidden');
      }
      input?.focus();
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorEl) {
        errorEl.classList.add('hidden');
        errorEl.textContent = '';
      }

      const formData = new FormData(form);
      const email = (formData.get('email') || '').toString().trim();
      const art = formData.get('art') || 'Installation';
      const objektgroesse = (formData.get('objektgroesse') || '').toString().trim();
      const bezirk = (formData.get('bezirk') || '').toString().trim();
      const telefon = (formData.get('telefon') || '').toString().trim();
      const nachricht = (formData.get('nachricht') || '').toString().trim();
      const formId = (formData.get('_formId') || 'kostenloses-angebot').toString();

      if (!email) {
        showError('Bitte geben Sie Ihre E-Mail-Adresse an.', form.querySelector('input[name="email"]'));
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
        showError('Bitte geben Sie eine gültige E-Mail-Adresse ein.', form.querySelector('input[name="email"]'));
        return;
      }

      const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';
        submitBtn.textContent = 'Wird gesendet …';
      }

      try {
        const payload = {
          _formId: formId,
          email,
          subject: `Neue Angebotsanfrage: ${art} in Berlin`,
          art,
          objektgroesse: objektgroesse || 'Nicht angegeben',
          bezirk: bezirk || 'Nicht angegeben',
          telefon: telefon || 'Nicht angegeben',
          nachricht: nachricht || 'Keine Angabe'
        };

        const res = await fetch('/psapi-internal-v1/forms/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (res.ok || res.status === 200 || res.status === 201) {
          form.classList.add('hidden');
          if (successEl) {
            successEl.classList.remove('hidden');
            successEl.classList.add('flex');
            successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        } else {
          const data = await res.json().catch(() => ({}));
          showError(data.message || 'Die Anfrage konnte nicht übermittelt werden. Bitte rufen Sie uns direkt an: 030 863 28 38 6');
        }
      } catch (err) {
        form.classList.add('hidden');
        if (successEl) {
          successEl.classList.remove('hidden');
          successEl.classList.add('flex');
          successEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.style.opacity = '';
          submitBtn.innerHTML = originalBtnHtml;
        }
      }
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      form.classList.remove('hidden');
      if (successEl) {
        successEl.classList.add('hidden');
        successEl.classList.remove('flex');
      }
    });
  })();
</script>
