---
import Container from '@/components/Container.astro';

const faqs = [
  { q: 'Kann ich Rauchmelder in Berlin professionell installieren lassen?', a: 'Ja. Wir übernehmen Planung, Geräteauswahl und fachgerechte Montage: von der einzelnen Mietwohnung bis zum Mehrfamilienhaus. Jede Installation wird anschließend dokumentiert.' },
  { q: 'Was kostet eine Rauchmelder-Installation in Berlin?', a: 'Das hängt von der Anzahl der Melder und Wohnungen sowie vom Montageaufwand ab. Beschreiben Sie uns kurz Ihr Objekt: Sie erhalten vor der Beauftragung ein nachvollziehbares Angebot.' },
  { q: 'Wie läuft eine Rauchmelder-Wartung ab?', a: 'Wir prüfen Position, Zustand, Funktion und Alter jedes Geräts, testen die Alarmfunktion und halten alle Ergebnisse in Ihrer Dokumentation fest. Anschließend sagen wir Ihnen, was zu tun ist und was nicht.' },
  { q: 'Prüfen Sie auch vorhandene Rauchmelder?', a: 'Ja, ausdrücklich. Wir beurteilen Zustand, Position, Alter und Funktion Ihrer Bestandsgeräte und tauschen nur aus, was wirklich nötig ist.' },
  { q: 'Welche Punkte werden bei einer Rauchmelder-Kontrolle geprüft?', a: 'Vier Dinge: ob alle erforderlichen Räume ausgestattet sind, ob jeder Melder sinnvoll positioniert ist, ob er zuverlässig funktioniert und ob Alter und Austauschzeitpunkt noch passen.' },
  { q: 'Wer muss Rauchmelder in Berlin installieren?', a: 'Die Ausstattung der Wohnung liegt grundsätzlich in der Verantwortung der Eigentümerinnen und Eigentümer. Wer vermietet, sollte diese Pflicht also nicht den Mietern überlassen.' },
  { q: 'In welchen Räumen sind Rauchmelder in Berlin Pflicht?', a: 'Nach § 48 BauO Bln in Schlafräumen und Kinderzimmern sowie in Fluren, die als Rettungswege dienen. In Wohnräumen sind Melder zusätzlich sinnvoll, in Küchen prüfen wir die passende Lösung.' },
  { q: 'Wie oft sollten Rauchmelder geprüft werden?', a: 'Das richtet sich nach Gerät, Herstellerangaben und Wartungskonzept: Viele Konzepte sehen eine regelmäßige Prüfung vor. Wir sagen Ihnen, was für Ihre Geräte gilt, und erinnern an den nächsten Termin.' },
  { q: 'Wann sollten Rauchmelder ausgetauscht werden?', a: 'Spätestens am Ende der vom Hersteller angegebenen Lebensdauer (bei vielen Geräten nach etwa zehn Jahren) sowie bei Defekten, Verschmutzung oder Beschädigung.' },
  { q: 'Kann Normcheck Termine direkt mit Mietern koordinieren?', a: 'Ja, auf Wunsch. Wir stimmen Besuchstermine mit Ihren Bewohnern ab, halten offene Wohnungen nach und melden Ihnen den aktuellen Status je Einheit zurück.' },
  { q: 'Bekomme ich nach der Prüfung eine Dokumentation?', a: 'Ja. Sie erhalten ein digitales Protokoll mit allen Geräten, Prüfergebnissen, festgestellten Mängeln, durchgeführten Maßnahmen und dem Hinweis zum nächsten fälligen Termin.' },
  { q: 'Welche Rauchmelder werden eingebaut?', a: 'Geräte nach DIN EN 14604, in der Regel mit 10-Jahres-Batterie, auf Wunsch mit Q-Label oder als ferninspizierbare Variante. Die konkrete Auswahl treffen wir passend zu Ihrem Objekt.' },
  { q: 'Arbeiten Sie in allen Berliner Bezirken?', a: 'Ja, wir sind in allen zwölf Berliner Bezirken im Einsatz und nach Absprache auch im Berliner Umland in Brandenburg.' },
  { q: 'Betreuen Sie auch Mehrfamilienhäuser?', a: 'Ja, vom kleinen Wohnungspaket bis zur großen Wohnanlage: mit Terminplanung, optionaler Bewohnerkoordination und einer Dokumentation, die jedem Gerät seine Wohnung zuordnet.' },
  { q: 'Können bereits vorhandene Geräte weiterverwendet werden?', a: 'Wenn sie fachlich in Ordnung, sinnvoll positioniert und nicht zu alt sind: ja. Wir prüfen jedes Gerät einzeln, statt pauschal alles zu erneuern.' },
];
---

<section id="faq" class="py-14 md:py-20 lg:py-24 bg-white" aria-labelledby="faq-heading" data-ps="src/components/home/v2/FaqSection.astro:8l82hj">
  <Container>
    <div class="text-center max-w-2xl mx-auto mb-10 md:mb-14 md:max-w-[697px]" data-ps="src/components/home/v2/FaqSection.astro:qjblc0">
      <p class="inline-flex items-center justify-center gap-2 text-[13px] font-extrabold tracking-[0.08em] uppercase text-[#2F6870] mb-3" data-ps="src/components/home/v2/FaqSection.astro:5mrkq3">
        <span class="w-6 h-[3px] rounded-full bg-[#C99A63]" aria-hidden="true" data-ps="src/components/home/v2/FaqSection.astro:t7euf5"></span>
        Häufige Fragen
        <span class="w-6 h-[3px] rounded-full bg-[#C99A63]" aria-hidden="true" data-ps="src/components/home/v2/FaqSection.astro:t7euf6"></span>
      </p>
      <h2 id="faq-heading" class="font-heading text-[28px] sm:text-[34px] lg:text-[40px] font-black tracking-tight text-[#123F46] leading-[1.15] mb-4" data-ps="src/components/home/v2/FaqSection.astro:6j1b6u">
        Das fragen uns Vermieter und Eigentümer
      </h2>
      <p class="text-[16px] text-[#5D6E70] leading-relaxed m-0" data-ps="src/components/home/v2/FaqSection.astro:p0tkxv">
        Kurz und konkret beantwortet. Ihre Frage ist nicht dabei? Rufen Sie uns an: <a href="tel:+493086328386" class="font-bold text-[#123F46] hover:text-[#67C53A]" data-ps="src/components/home/v2/FaqSection.astro:cqphfs">030 863 28 386</a>
      </p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 max-w-6xl mx-auto" data-ps="src/components/home/v2/FaqSection.astro:qjblbz">
      {faqs.map((f, i) => (
        <div class="faq-v2-item self-start rounded-2xl border border-[#DCE4DF] bg-white shadow-[0_12px_35px_rgba(18,63,70,0.08)] overflow-hidden transition-colors hover:border-[#2F6870]/30" data-ps={`src/components/home/v2/FaqSection.astro:qjblby-${i}`}>
          <h3 class="m-0" data-ps={`src/components/home/v2/FaqSection.astro:61zo1x-${i}`}>
            <button
              type="button"
              class="faq-v2-trigger w-full flex items-center justify-between gap-4 px-5 py-4 text-left cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#123F46]"
              aria-expanded="false"
              aria-controls={`faq-v2-panel-${i}`}
              id={`faq-v2-trigger-${i}`}
             data-ps={`src/components/home/v2/FaqSection.astro:8ci0jl-${i}`}>
              <span class="text-[15px] font-extrabold text-[#123F46] leading-snug" data-ps={`src/components/home/v2/FaqSection.astro:t7euf7-${i}`}>{f.q}</span>
              <span class="faq-v2-icon flex items-center justify-center w-8 h-8 rounded-full bg-[#F7F5EF] shrink-0 transition-transform duration-300" aria-hidden="true" data-ps={`src/components/home/v2/FaqSection.astro:t7euf8-${i}`}>
                <svg class="w-4 h-4 text-[#2F6870]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg>
              </span>
            </button>
          </h3>
          <div id={`faq-v2-panel-${i}`} role="region" aria-labelledby={`faq-v2-trigger-${i}`} class="faq-v2-panel grid transition-[grid-template-rows] duration-300 ease-out [grid-template-rows:0fr]" data-ps={`src/components/home/v2/FaqSection.astro:qjblbx-${i}`}>
            <div class="overflow-hidden" data-ps={`src/components/home/v2/FaqSection.astro:qjblbw-${i}`}>
              <p class="px-5 pb-5 text-[14.5px] text-[#5D6E70] leading-relaxed m-0" data-ps={`src/components/home/v2/FaqSection.astro:p0tkxu-${i}`}>{f.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

<script is:inline>
  document.querySelectorAll('.faq-v2-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-v2-item');
      const panel = item?.querySelector('.faq-v2-panel');
      const icon = item?.querySelector('.faq-v2-icon');
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';

      trigger.setAttribute('aria-expanded', String(!isOpen));
      if (panel) panel.style.gridTemplateRows = isOpen ? '0fr' : '1fr';
      if (icon) icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(45deg)';
    });
  });
</script>
  </Container>
</section>
