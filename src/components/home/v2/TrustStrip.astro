---
import Container from '@/components/Container.astro';

const items = [
  {
    label: 'Berlin vor Ort',
    icon: '<path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  },
  {
    label: 'Digitale Dokumentation',
    icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/>',
  },
  {
    label: 'Vorhandene Geräte zuerst prüfen',
    icon: '<circle cx="11" cy="11" r="6.5"/><path d="m20.5 20.5-4.6-4.6"/><path d="m8.2 11.2 2 2 3.6-4.2"/>',
  },
  {
    label: 'Bewohnerkoordination möglich',
    icon: '<rect x="3" y="4.5" width="18" height="16" rx="2.5"/><path d="M8 2.5v4M16 2.5v4M3 9.5h18"/><path d="m10.5 14.5 1.8 1.8 3.2-3.6"/>',
  },
];
---

<section class="bg-[#062B4A] border-y border-[#0B3A64]" aria-label="Ihre Vorteile auf einen Blick">
  <Container>
    <ul class="grid grid-cols-2 lg:grid-cols-4 list-none p-0 m-0">
      {items.map((item, i) => (
        <li class:list={[
          'flex items-center gap-3 py-4 md:py-5 pr-3',
          i % 2 === 0 ? 'border-r border-white/10' : '',
          i < 2 ? 'max-lg:border-b max-lg:border-white/10' : '',
          i > 0 ? 'lg:border-r lg:border-white/10 lg:pl-6' : '',
          i === 3 ? 'lg:!border-r-0' : '',
          i % 2 === 1 ? 'max-lg:pl-4' : '',
        ]}>
          <span class="relative flex items-center justify-center w-10 h-10 md:w-11 md:h-11 rounded-xl bg-white/[0.07] shrink-0" aria-hidden="true">
            <svg class="w-5 h-5 md:w-[22px] md:h-[22px] text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
            <span class="absolute -top-1 -right-1 w-2.5 h-2.5 rounded-full bg-[#63c62f] border-2 border-[#062B4A]"></span>
          </span>
          <span class="text-white text-[13px] sm:text-[14px] md:text-[15px] font-bold leading-tight">{item.label}</span>
        </li>
      ))}
    </ul>
  </Container>
</section>
