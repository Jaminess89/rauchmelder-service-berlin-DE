---
import Container from '@/components/Container.astro';
---

<section id="ansprechpartner" class="py-12 md:py-16 lg:py-20 bg-[#F7F5EF] why-section relative overflow-hidden" aria-labelledby="about-heading" data-ps="src/components/home/v2/AboutSection.astro:gcmfo3">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.12fr] gap-8 lg:gap-12 items-center" data-ps="src/components/home/v2/AboutSection.astro:5n4xey">

      {/* Foto-Spalte */}
      <div class="relative order-2 lg:order-1 w-full" data-ps="src/components/home/v2/AboutSection.astro:5n4xex">
        <div class="w-full rounded-[22px] overflow-hidden shadow-[0_12px_35px_rgba(18,63,70,0.12)] ring-1 ring-[#DCE4DF]" data-ps="src/components/home/v2/AboutSection.astro:5n4xew">
          <img
            src="https://pagesmith-cdn.com/0c80a694/images/Unsere-Techniker-mit-Wagen-768-be991c-768.webp"
            srcset="https://pagesmith-cdn.com/0c80a694/images/Unsere-Techniker-mit-Wagen-768-be991c-320.webp 320w, https://pagesmith-cdn.com/0c80a694/images/Unsere-Techniker-mit-Wagen-768-be991c-640.webp 640w, https://pagesmith-cdn.com/0c80a694/images/Unsere-Techniker-mit-Wagen-768-be991c-768.webp 768w"
            sizes="(max-width: 1024px) 100vw, 48vw"
            width="768"
            height="606"
            alt="Normcheck Rauchmelder Service Berlin Techniker vor Einsatzfahrzeug"
            class="w-full h-auto block object-cover"
            loading="lazy"
            decoding="async"
            data-ps="src/components/home/v2/AboutSection.astro:zidw28"
          />
        </div>
      </div>

      {/* Copy / Why-Bereich */}
      <div class="order-1 lg:order-2 flex flex-col justify-between" data-ps="src/components/home/v2/AboutSection.astro:5n4xeu">
        <div class="why-in" data-ps="src/components/home/v2/AboutSection.astro:wv0nv0">
          <div class="why-kicker" data-ps="src/components/home/v2/AboutSection.astro:kicker"><i></i> WARUM NORMCHECK</div>

          <h2 id="about-heading" data-ps="src/components/home/v2/AboutSection.astro:7fqzp7">
            Persönlicher<br>
            Rauchmelderservice<br>
            in Berlin
          </h2>

          <p class="why-lead" data-ps="src/components/home/v2/AboutSection.astro:skp2er">
            Lokaler Fachbetrieb. Direkte Ansprechpartner. Klare Ergebnisse.
          </p>

          <div class="why-grid" data-ps="src/components/home/v2/AboutSection.astro:why-grid">

            <div class="why-item" data-ps="src/components/home/v2/AboutSection.astro:item-1">
              <div class="why-icon" data-ps="src/components/home/v2/AboutSection.astro:wv0nuz">
                <svg viewBox="0 0 48 48">
                  <circle cx="24" cy="14" r="6"/>
                  <path d="M14 39v-6c0-6 4-10 10-10s10 4 10 10v6"/>
                </svg>
              </div>
              <div data-ps="src/components/home/v2/AboutSection.astro:wv0nuy">
                <h3 data-ps="src/components/home/v2/AboutSection.astro:2shnom">Direkter Ansprechpartner</h3>
                <p data-ps="src/components/home/v2/AboutSection.astro:skp2dt">Kein Callcenter</p>
              </div>
            </div>

            <div class="why-item" data-ps="src/components/home/v2/AboutSection.astro:item-2">
              <div class="why-icon" data-ps="src/components/home/v2/AboutSection.astro:5n4xf2">
                <svg viewBox="0 0 48 48">
                  <path d="M15 7 10 10c-2 2 1 10 7 17s14 11 16 9l4-5-9-6-4 4c-4-2-8-6-10-10l4-4z"/>
                </svg>
              </div>
              <div data-ps="src/components/home/v2/AboutSection.astro:5n4xf1">
                <h3 data-ps="src/components/home/v2/AboutSection.astro:2shnon">Schnell erreichbar</h3>
                <p data-ps="src/components/home/v2/AboutSection.astro:skp2du">Mo bis Sa telefonisch & per
<br/>Formular</p>
              </div>
            </div>

            <div class="why-item" data-ps="src/components/home/v2/AboutSection.astro:item-3">
              <div class="why-icon" data-ps="src/components/home/v2/AboutSection.astro:5n4xf0">
                <svg viewBox="0 0 48 48">
                  <path d="M24 42s12-11 12-22a12 12 0 1 0-24 0c0 11 12 22 12 22z"/>
                  <circle cx="24" cy="20" r="4"/>
                </svg>
              </div>
              <div data-ps="src/components/home/v2/AboutSection.astro:5n4xez">
                <h3 data-ps="src/components/home/v2/AboutSection.astro:2shnoo">Aus Berlin</h3>
                <p data-ps="src/components/home/v2/AboutSection.astro:skp2dv">Kurze Wege in allen Bezirken</p>
              </div>
            </div>

            <div class="why-item" data-ps="src/components/home/v2/AboutSection.astro:item-4">
              <div class="why-icon" data-ps="src/components/home/v2/AboutSection.astro:5n4xey">
                <svg viewBox="0 0 48 48">
                  <circle cx="20" cy="20" r="10"/>
                  <path d="m27 27 10 10"/>
                </svg>
              </div>
              <div data-ps="src/components/home/v2/AboutSection.astro:5n4xex">
                <h3 data-ps="src/components/home/v2/AboutSection.astro:2shnop">Vorhandene Melder prüfen</h3>
                <p data-ps="src/components/home/v2/AboutSection.astro:skp2dw">Erst prüfen, dann sinnvoll<br>handeln</p>
              </div>
            </div>

            <div class="why-item" data-ps="src/components/home/v2/AboutSection.astro:item-5">
              <div class="why-icon" data-ps="src/components/home/v2/AboutSection.astro:5n4xew">
                <svg viewBox="0 0 48 48">
                  <path d="M31 8a10 10 0 0 0-9 13L9 34a4 4 0 0 0 5 5l13-13A10 10 0 0 0 39 15l-7 5-5-2-2-5z"/>
                </svg>
              </div>
              <div data-ps="src/components/home/v2/AboutSection.astro:5n4xev">
                <h3 data-ps="src/components/home/v2/AboutSection.astro:2shnoq">Saubere Montage</h3>
                <p data-ps="src/components/home/v2/AboutSection.astro:skp2dx">Ordentlich, vorsichtig,<br>zuverlässig</p>
              </div>
            </div>

            <div class="why-item" data-ps="src/components/home/v2/AboutSection.astro:item-6">
              <div class="why-icon" data-ps="src/components/home/v2/AboutSection.astro:5n4xeu">
                <svg viewBox="0 0 48 48">
                  <path d="M14 6h15l7 7v29H14z"/>
                  <path d="M29 6v8h7M20 24h10M20 30h10"/>
                </svg>
              </div>
              <div data-ps="src/components/home/v2/AboutSection.astro:5n4xet">
                <h3 data-ps="src/components/home/v2/AboutSection.astro:2shnor">Digitales Protokoll</h3>
                <p data-ps="src/components/home/v2/AboutSection.astro:skp2ej">Klare Ergebnisse schwarz<br>auf weiß</p>
              </div>
            </div>

          </div>

          <a href="#ersteinschaetzung" class="why-cta" data-ps="src/components/home/v2/AboutSection.astro:cta">
            <svg viewBox="0 0 48 48">
              <rect x="9" y="12" width="30" height="27" rx="3"/>
              <path d="M9 20h30M16 7v10M32 7v10"/>
            </svg>
            <span data-ps="src/components/home/v2/AboutSection.astro:o6oz2b">Jetzt unverbindlich anfragen</span>
            <b>→</b>
          </a>

          <div class="why-trust" data-ps="src/components/home/v2/AboutSection.astro:trust">
            <svg viewBox="0 0 48 48">
              <path d="M24 5 38 11v11c0 10-6 17-14 21-8-4-14-11-14-21V11z"/>
              <path d="m18 24 4 4 8-9"/>
            </svg>
            Persönlich. Lokal. Dokumentiert.
          </div>
        </div>
      </div>

    </div>
  </Container>
</section>

<style>
.why-section {
  --navy: #07364a;
  --green: #089849;
  --text: #60737c;
  color: var(--navy);
}
.why-in {
  position: relative;
  width: 100%;
}
.why-kicker {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: 2.5px;
  color: var(--navy);
  text-transform: uppercase;
}
.why-kicker i {
  width: 32px;
  height: 4px;
  border-radius: 4px;
  background: #13a354;
  display: inline-block;
}
.why-section h2 {
  margin: 16px 0 12px;
  font-size: clamp(32px, 3.6vw, 46px);
  line-height: 1.06;
  letter-spacing: -1.5px;
  font-weight: 900;
  color: var(--navy);
}
.why-lead {
  margin: 0 0 24px;
  color: #526b75;
  font-size: 16.5px;
  line-height: 1.45;
  font-weight: 500;
}
.why-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px 24px;
}
.why-item {
  display: grid;
  grid-template-columns: 54px 1fr;
  gap: 14px;
  align-items: start;
}
.why-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border: 1px solid #e3e8e6;
  border-radius: 14px;
  background: #fff;
  box-shadow: 0 6px 18px rgba(8, 53, 66, 0.06);
}
.why-icon svg {
  width: 28px;
  height: 28px;
  fill: none;
  stroke: var(--green);
  stroke-width: 2.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.why-item h3 {
  margin: 2px 0 4px;
  font-size: 15.5px;
  line-height: 1.2;
  font-weight: 900;
  color: var(--navy);
}
.why-item p {
  margin: 0;
  color: #627982;
  font-size: 13.5px;
  line-height: 1.35;
}
.why-cta {
  width: 100%;
  max-width: 420px;
  height: 56px;
  margin-top: 28px;
  padding: 0 22px;
  display: flex;
  align-items: center;
  gap: 14px;
  border-radius: 14px;
  background: linear-gradient(180deg, #28b75c, #0e9448);
  color: #fff;
  text-decoration: none;
  box-shadow: 0 10px 22px rgba(16, 150, 72, 0.2);
  font-size: 15.5px;
  font-weight: 800;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.why-cta:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 28px rgba(16, 150, 72, 0.28);
}
.why-cta svg {
  width: 24px;
  height: 24px;
  fill: none;
  stroke: #fff;
  stroke-width: 2.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.why-cta span {
  flex: 1;
}
.why-cta b {
  font-size: 24px;
  font-weight: 400;
}
.why-trust {
  margin: 16px 0 0 6px;
  display: flex;
  align-items: center;
  gap: 10px;
  color: #58717b;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}
.why-trust svg {
  width: 20px;
  height: 20px;
  fill: none;
  stroke: var(--green);
  stroke-width: 2.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

@media (max-width: 650px) {
  .why-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .why-item {
    grid-template-columns: 46px 1fr;
    gap: 12px;
  }
  .why-icon {
    width: 46px;
    height: 46px;
    border-radius: 12px;
  }
  .why-icon svg {
    width: 24px;
    height: 24px;
  }
  .why-cta {
    width: 100%;
    height: 52px;
    padding: 0 16px;
    font-size: 14.5px;
  }
  .why-trust {
    margin: 14px 0 0;
    justify-content: flex-start;
    font-size: 12px;
  }
}
</style>
