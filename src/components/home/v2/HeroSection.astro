</section>

<style>
:root {
  --mk-navy: #082d4a;
  --mk-navy2: #0d3655;
  --mk-green: #58d21f;
  --mk-green2: #4bc417;
  --mk-white: #fff;
  --mk-muted: #d6e0e8;
  --mk-border: rgba(255,255,255,.17);
}

.mk-hero {
  position: relative;
  min-height: 720px;
  overflow: hidden;
  background-color: #062b47;
  color: var(--mk-white);
  font-family: var(--font-heading, 'Plus Jakarta Sans'), sans-serif;
  padding-top: 68px; /* Offset for the 68px navbar */
}

/* Background container strictly below the menu */
.mk-hero__bg-wrap {
  position: absolute;
  top: 68px;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: calc(100% - 68px);
  overflow: hidden;
  z-index: 1;
  background: radial-gradient(circle at 85% 30%, #0d4672 0%, #062b47 60%, #041d33 100%);
}

.mk-hero__technician-wrap {
  position: absolute;
  right: 4%;
  bottom: 0;
  top: 20px;
  width: 44%;
  max-width: 600px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  z-index: 1;
  pointer-events: none;
}

.mk-hero__technician-img {
  max-height: calc(100% - 10px);
  width: auto;
  max-width: 100%;
  object-fit: contain;
  object-position: bottom right;
  display: block;
  filter: drop-shadow(0 25px 45px rgba(0, 0, 0, 0.5));
}

/* Overlay that keeps text perfectly readable while displaying the technician on the right */
.mk-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    linear-gradient(90deg, 
      #062b47 0%, 
      rgba(6, 43, 71, 0.96) 42%, 
      rgba(6, 43, 71, 0.60) 65%, 
      transparent 85%),
    linear-gradient(180deg, 
      rgba(6, 43, 71, 0.35) 0%, 
      transparent 25%, 
      rgba(4, 29, 51, 0.5) 100%);
  pointer-events: none;
}

.mk-hero__inner {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 1500px;
  min-height: 650px;
  margin-inline: auto;
  padding-inline: 20px;
  display: flex;
  align-items: center;
}

@media (min-width: 768px) {
  .mk-hero__inner {
    padding-inline: 60px;
  }
}

@media (min-width: 1280px) {
  .mk-hero__inner {
    padding-inline: 115px;
  }
}

.mk-hero__content {
  position: relative;
  z-index: 4;
  padding: 40px 0 60px;
  max-width: 960px;
}

.mk-hero h1 {
  margin: 0;
  font-size: clamp(44px, 4.4vw, 76px);
  line-height: 1.02;
  letter-spacing: -0.035em;
  font-weight: 850;
  color: #fff;
  font-family: var(--font-heading, 'Plus Jakarta Sans'), sans-serif;
}

.mk-hero h1 span {display: block; margin-top: 14px; color: var(--mk-green); letter-spacing: -0.025em; font-weight: 800;}

.mk-hero h1 b.dot {
  font-weight: 800;
  margin: 0 0.08em;
  display: inline-block;
  color: var(--mk-green);
}

.mk-lead {margin: 32px 0 0; line-height: 1.5; font-weight: 450; letter-spacing: -0.015em; color: #dce7f0; font-family: var(--font-sans, sans-serif);}

.mk-benefits {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 38px;
}

.mk-benefit {
  min-height: 52px;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 10px 18px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 14px;
  background: rgba(20, 58, 86, 0.65);
  box-shadow:
    inset 0 1px rgba(255, 255, 255, 0.08),
    0 8px 24px rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #fff;
  font-size: 15.5px;
  line-height: 1.2;
  font-weight: 700;
  font-family: var(--font-sans, sans-serif);
}

.mk-check-badge {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--mk-green);
  color: #06324c;
  font-style: normal;
  font-size: 16px;
  font-weight: 900;
  line-height: 1;
}

.mk-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 18px;
  margin-top: 42px;
}

.mk-btn {
  min-height: 68px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 0 34px;
  border-radius: 14px;
  text-decoration: none;
  font-size: 18px;
  line-height: 1;
  font-weight: 800;
  transition: all .18s ease;
  font-family: var(--font-heading, sans-serif);
}

.mk-btn--primary {
  min-width: 340px;
  background: linear-gradient(135deg, #60db24, #51cb18);
  color: #fff;
  box-shadow: 0 14px 30px rgba(82, 206, 27, 0.32);
}

.mk-btn--primary .mk-arrow {
  font-size: 24px;
  line-height: 1;
  transform: translateY(-1px);
  transition: transform .18s ease;
}

.mk-btn--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 18px 36px rgba(82, 206, 27, 0.45);
}

.mk-btn--primary:hover .mk-arrow {
  transform: translate(4px, -1px);
}

.mk-btn--phone {
  min-width: 240px;
  color: #fff;
  background: rgba(20, 58, 86, 0.75);
  border: 1px solid rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.mk-btn--phone:hover {
  background: rgba(30, 75, 108, 0.95);
  border-color: rgba(255, 255, 255, 0.38);
  transform: translateY(-2px);
}

.mk-phone-svg {
  width: 22px;
  height: 22px;
  color: var(--mk-green);
  flex-shrink: 0;
}

.mk-note {
  margin: 16px 0 0 8px;
  font-size: 15px;
  font-weight: 600;
  color: #b0c2d0;
  font-family: var(--font-sans, sans-serif);
}

@media (max-width: 1180px) {
  .mk-hero__content {
    max-width: 740px;
    padding: 30px 0 50px;
  }
}

@media (max-width: 1024px) {
  .mk-hero__technician-wrap {
    width: 45%;
    right: 0;
    opacity: 0.65;
  }
  .mk-hero__overlay {
    background:
      linear-gradient(90deg, 
        #062b47 0%, 
        rgba(6, 43, 71, 0.95) 55%, 
        rgba(6, 43, 71, 0.8) 100%);
  }
}

@media (max-width: 768px) {
  .mk-hero {
    min-height: auto;
    padding-top: 68px;
  }

  .mk-hero__bg-wrap {
    top: 0;
    height: 100%;
    z-index: 0;
  }

  .mk-hero__technician-wrap {
    width: 100%;
    max-width: none;
    right: 0;
    left: 0;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: stretch;
    opacity: 1;
  }

  .mk-hero__technician-img {
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center top;
  }

  .mk-hero__overlay {
    background:
      linear-gradient(180deg,
        rgba(6, 43, 71, 0.55) 0%,
        rgba(6, 43, 71, 0.62) 55%,
        rgba(6, 43, 71, 0.78) 100%);
  }

  .mk-hero__inner {
    min-height: auto;
  }

  .mk-hero__content {
    padding: 20px 0 45px;
  }

  .mk-hero h1 {
    font-size: clamp(34px, 9vw, 48px);
    letter-spacing: -0.025em;
  }

  .mk-hero h1 span {margin-top: 10px; letter-spacing: -0.015em;}

  .mk-lead {margin-top: 18px; line-height: 1.45;}

  .mk-benefits {
    display: grid;
    gap: 8px;
    margin-top: 24px;
  }

  .mk-benefit {
    min-height: 46px;
    width: 100%;
    padding: 8px 14px;
    font-size: 14px;
  }

  .mk-check-badge {
    width: 24px;
    height: 24px;
    flex-basis: 24px;
    font-size: 14px;
  }

  .mk-actions {
    display: grid;
    gap: 12px;
    margin-top: 26px;
  }

  .mk-btn {
    width: 100%;
    min-width: 0;
    min-height: 58px;
    padding: 0 20px;
    font-size: 16.5px;
  }

  .mk-note {
    text-align: center;
    margin: 10px 0 0;
  }
}
</style>
