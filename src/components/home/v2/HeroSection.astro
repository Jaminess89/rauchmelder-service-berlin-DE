        <div class="mk-benefit" data-ps="src/components/home/v2/HeroSection.astro:zd82jp-2">
          <span class="mk-check-badge" data-ps="src/components/home/v2/HeroSection.astro:9ztpwy">✓</span>
          <span data-ps="src/components/home/v2/HeroSection.astro:9ztpwx">Mietertermine auf Wunsch</span>
