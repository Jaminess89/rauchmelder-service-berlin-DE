---
import Container from '@/components/Container.astro';

const districts = [
  { name: 'Mitte', x: 185, y: 138 },
  { name: 'Friedrichshain-Kreuzberg', x: 228, y: 163 },
  { name: 'Pankow', x: 215, y: 84 },
  { name: 'Charlottenburg-Wilmersdorf', x: 108, y: 158 },
  { name: 'Spandau', x: 58, y: 148 },
  { name: 'Steglitz-Zehlendorf', x: 128, y: 216 },
  { name: 'Tempelhof-Schöneberg', x: 178, y: 190 },
  { name: 'Neukölln', x: 222, y: 201 },
  { name: 'Treptow-Köpenick', x: 302, y: 192 },
  { name: 'Marzahn-Hellersdorf', x: 322, y: 118 },
  { name: 'Lichtenberg', x: 262, y: 133 },
  { name: 'Reinickendorf', x: 132, y: 98 },
];
---

<section id="einsatzgebiet" class="relative py-14 md:py-20 lg:py-24 overflow-hidden" aria-labelledby="berlin-heading" data-ps="src/components/home/v2/BerlinSection.astro:tkkm1l">
  {/* Hintergrundbild mit dezent transparenter Farbüberlagerung */}
  <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true" data-ps="src/components/home/v2/BerlinSection.astro:jvsohc">
    <img
      src="https://pagesmith-cdn.com/0c80a694/images/sebastian-herrmann-k08MDpZm5zY-unsplash-1024-730d16-1024.webp"
      srcset="https://pagesmith-cdn.com/0c80a694/images/sebastian-herrmann-k08MDpZm5zY-unsplash-1024-730d16-320.webp 320w, https://pagesmith-cdn.com/0c80a694/images/sebastian-herrmann-k08MDpZm5zY-unsplash-1024-730d16-640.webp 640w, https://pagesmith-cdn.com/0c80a694/images/sebastian-herrmann-k08MDpZm5zY-unsplash-1024-730d16-768.webp 768w, https://pagesmith-cdn.com/0c80a694/images/sebastian-herrmann-k08MDpZm5zY-unsplash-1024-730d16-1024.webp 1024w"
      sizes="100vw"
      alt="Berlin Dächer mit Fernsehturm"
      class="w-full h-full object-cover object-[center_60%]"
      loading="lazy" data-ps="src/components/home/v2/BerlinSection.astro:la2euj" />
    <div class="absolute inset-0 bg-gradient-to-r from-[#0b2b30]/80 via-[#123F46]/65 to-[#0b2b30]/75" data-ps="src/components/home/v2/BerlinSection.astro:jvsohb"></div>
  </div>

  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-8 lg:gap-12 items-center" data-ps="src/components/home/v2/BerlinSection.astro:jvsohc">

      {/* Detail-Karte von Berlin (um 25% vergrößert) */}
      <div class="order-2 lg:order-1 flex items-center justify-center w-full" data-ps="src/components/home/v2/BerlinSection.astro:jvsohb">
        <div class="berlin-map-wrap w-full max-w-[780px] lg:max-w-none mx-auto drop-shadow-[0_20px_35px_rgba(0,0,0,0.55)] scale-100 lg:scale-[1.12] origin-center" data-ps="src/components/home/v2/BerlinSection.astro:jvsoha">
          <svg viewBox="-80 -140 1180 920" class="w-full h-auto block overflow-visible" role="img" aria-label="Karte der 12 Berliner Bezirke">
            <defs>
              <path id="berlin-outline" d="M438,72l-60,8,-36,-8,-16,1,12,-4,-7,-11,5,-8,-13,-17,15,-5,-42,-6,2,30,-33,1,4,9,-1,12,-67,-2,-6,12,-23,21,27,21,-3,8,-18,1,-62,-18,-32,14,-22,3,-2,7,7,5,26,-6,6,16,-12,19,0,12,-23,-5,-17,39,-3,20,39,-4,39,16,-61,45,-16,4,-11,17,3,12,-5,11,21,18,-28,23,-8,-2,-17,8,4,13,10,3,-2,-6,7,-1,0,5,8,2,5,-5,4,3,-9,3,28,18,21,-1,-12,11,-5,-2,6,7,4,-3,-5,-2,17,-10,41,4,4,-5,-20,2,2,-10,58,-19,42,-9,32,0,6,25,37,0,34,-17,23,26,48,-20,0,7,44,21,-3,8,26,0,2,16,49,3,10,-16,-13,-36,68,-17,7,2,18,36,55,-8,21,6,13,-5,-4,18,43,1,44,-8,4,10,16,12,0,8,34,-11,7,7,15,-1,-1,10,7,1,1,4,-13,10,-4,21,17,13,6,-2,9,-18,14,-10,7,-13,17,-5,15,4,12,-13,-4,-2,2,-7,-18,-5,44,-22,24,-1,11,-11,-14,-14,12,-15,6,0,-2,-9,-16,-2,-5,-2,-5,-3,30,6,2,-8,10,-5,9,0,-3,7,10,-1,-9,-1,3,-7,-4,-1,3,-4,-42,-7,-20,-18,-22,-9,-3,0,9,13,-1,8,-10,-1,-4,-13,-72,-23,-35,8,-4,11,-2,-6,-15,0,8,-7,-5,-1,2,-8,23,-18,-9,-2,13,-26,40,-22,-3,-6,-47,-1,-1,-12,13,1,5,-7,-77,-12,2,-9,-9,-23,-20,-3,-10,-11,-23,-12,-29,-6,-30,0,-17,-22,13,-20,0,-9,19,-6,8,-24,-16,0,-34,-15,-8,-7,5,-17,-20,7,6,-14,-20,13,-10,-3,-13,9,34,10,-5,7,-16,6,-29,-2,-1,6,-9,1,0,10,-15,4,-18,-12,-27,-6,-8,15,-11,2,-9,7z" />
              <clipPath id="berlin-clip">
                <use href="#berlin-outline" />
              </clipPath>
              <linearGradient id="berlin-grad" x1="0" y1="0" x2="0" y2="1">
                <stop stop-color="#1a4377" />
                <stop offset=".5" stop-color="#10325f" />
                <stop offset="1" stop-color="#081d3a" />
              </linearGradient>
              <pattern id="berlin-pat" width="180" height="180" patternUnits="userSpaceOnUse">
                <path d="M8 32c22-18 52-18 74 0s52 18 74 0M0 82c18-16 42-16 60 0s42 16 60 0s42-16 60 0M6 132c26-20 56-20 82 0s56 20 82 0M34 5c18 14 18 38 0 52s-18 38 0 52s18 38 0 52M104 0c-14 20-14 44 0 64s14 44 0 64s-14 44 0 64" fill="none" stroke="#9fd8ff" stroke-opacity=".12" stroke-width="1.1" />
              </pattern>
            </defs>

            {/* Schattenebene */}
            <use href="#berlin-outline" class="berlin-shadow" transform="translate(4 17) scale(1 1.16)" />

            {/* Bezirke */}
            <g transform="translate(0 6) scale(1 1.16)">
              <path class="berlin-district" fill="url(#berlin-grad)" d="M473,190l14,25,-4,7,36,13,-10,13,10,6,-3,4,-20,3,-21,-8,-35,2,-13,14,-53,-12,1,-3,-7,-2,6,-3,-5,-1,8,-3,-10,-5,0,-6,-6,-4,-8,0,-6,5,-5,-14,7,-3,-7,1,-2,-6,26,-4,-2,-5,-15,-10,-25,-1,13,-14,26,-7,8,1,8,-4,41,5,4,4,16,-3,2,-9,15,-2,12,10,1,16z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M519,254l-10,-6,10,-13,-15,-7,35,-8,7,7,8,-2,4,10,29,3,6,7,-3,-1,0,7,-11,17,35,17,-20,2,-23,-13,-16,-3,-21,12,-29,-10,8,12,-3,3,-24,-4,-5,6,-15,2,0,-3,-35,1,4,0,3,-10,-12,-3,2,-8,12,-14,35,-2,21,8,20,-3z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M458,163l-63,-33,19,-2,16,-12,8,-18,-14,-22,14,-4,0,-5,9,-7,11,-2,8,-15,5,-2,15,9,7,-1,18,12,13,-3,2,-11,9,-1,1,-6,29,2,22,-9,-1,-4,-17,-2,-17,-8,13,-9,10,3,14,-12,6,-1,-6,13,20,-6,-5,17,8,7,34,15,10,-3,6,3,-8,24,-19,6,0,9,-11,14,-3,8,4,0,9,13,-25,10,-13,12,-1,14,13,6,-6,7,17,13,-1,8,-13,-3,-9,8,-19,-1,4,11,-6,6,4,3,-19,10,24,12,-26,-1,-4,-10,-8,2,-7,-7,-35,8,-21,-6,4,-7,-14,-25,-3,0,-1,-16z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M342,218l7,0,-7,3,5,14,7,-5,9,1,4,9,10,5,-8,3,5,1,-6,3,17,8,-7,6,3,2,-2,32,-26,1,0,16,-47,-5,-46,6,-42,-6,-49,3,-4,-4,-13,-1,-1,-10,4,-6,-5,-11,4,-12,31,-8,3,-10,6,0,8,-7,-3,-12,4,-7,39,3,-1,-6,15,2,37,-5,2,-6,-15,-7,2,-5,-5,-11,72,2,17,15,-26,4z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M87,175l12,-22,-3,-11,-29,4,-7,-5,2,-7,22,-3,21,-13,11,-1,62,18,18,-1,-3,5,6,11,9,6,5,15,38,19,26,2,5,10,-2,6,15,8,-2,5,-9,2,-43,1,1,6,-39,-3,-4,7,3,12,-8,7,-6,0,-3,10,-31,8,-4,12,5,11,-4,6,1,10,-4,14,-12,10,-10,0,-34,19,-39,6,-21,-17,5,-11,-3,-12,10,-11,1,-6,16,-4,61,-45,-39,-16,-39,4,3,-20,17,-39,9,5,14,0z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M419,387l-32,11,1,3,-47,20,-25,-24,1,-2,-34,17,-37,0,-6,-25,-32,0,-42,9,-58,19,-2,10,20,-2,1,3,-5,2,-41,-4,-17,10,5,2,-4,3,-7,-4,1,-3,6,0,-1,2,13,-9,-6,-2,5,0,-7,-3,-14,4,-28,-18,9,-3,-4,-3,-3,-1,-2,6,-8,-2,0,-5,-7,1,4,4,-2,2,-10,-3,-4,-13,17,-8,8,2,29,-26,38,-4,34,-19,10,0,12,-10,4,-14,13,1,4,4,49,-3,42,6,46,-6,59,9,12,-4,20,16,11,2,23,40z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M407,335l-10,-2,-20,-16,-12,4,-12,-4,0,-16,26,-1,2,-32,-3,-2,7,-6,43,9,-2,8,12,3,-3,10,-4,0,35,-1,0,3,9,0,11,-4,-2,12,11,-1,5,21,7,-1,3,8,-4,2,9,4,-8,0,-7,7,-22,46,5,0,-1,3,-8,3,4,8,26,3,-2,5,14,32,-10,16,-49,-3,-2,-16,-26,0,3,-8,-44,-21,-1,-10,32,-11,12,-12z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M478,386l22,-46,7,-7,8,0,-9,-4,4,-2,-3,-8,-7,1,-5,-21,-11,1,1,-10,1,-6,24,4,3,-3,-7,-12,54,18,3,-2,19,13,-1,6,13,14,-6,8,-27,-1,9,12,67,34,21,4,-3,5,8,15,-12,18,-55,8,-18,-36,-7,-2,-67,17,-14,-5,-12,1,-4,-8,8,-3,1,-3z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M988,379l-12,16,14,13,-5,2,-2,6,-17,6,-11,-2,-44,22,2,3,16,2,-2,7,5,0,-1,2,-12,13,-15,-4,-17,5,-7,7,0,6,-14,10,-9,14,0,4,-8,2,-15,-13,4,-21,13,-10,-1,-4,-7,-1,1,-11,-15,2,-7,-7,-34,11,0,-8,-16,-12,-4,-10,-44,8,-43,-1,4,-18,-13,5,-21,-6,12,-18,-8,-15,3,-5,-21,-4,-65,-32,-11,-14,27,1,6,-10,-13,-12,1,-6,-19,-13,-3,2,-25,-9,18,-11,12,1,29,15,17,-1,7,7,11,1,9,11,21,0,14,11,14,-11,41,2,11,-4,2,-5,17,-2,25,12,8,0,0,3,20,1,2,6,4,-11,28,-8,36,7,24,13,19,3,4,13,10,1,1,-8,-9,-13,3,0,22,9,20,18,42,7,-3,4,4,1,-3,7,9,1,-2,2,-8,-1,3,-7,-19,5,-2,8,-30,-6,26,7,-2,5,4,4z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M655,245l-3,-32,24,-6,-11,-24,24,-16,41,-13,21,5,9,23,-2,9,77,12,-5,7,-13,-1,1,12,47,1,3,6,-39,21,-14,27,9,2,-23,18,-2,8,5,1,-8,7,-38,-16,-17,2,-2,5,-11,4,-22,0,-7,-9,4,-9,-23,-30,3,-10z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M629,294l-11,-1,-4,-8,-35,-17,11,-17,0,-7,3,1,-12,-12,-21,-9,19,-10,-4,-3,6,-6,-4,-11,19,1,9,-8,13,3,2,-4,-6,-9,-12,-8,6,-7,-13,-6,2,-16,12,-10,25,-10,5,7,30,0,42,12,14,9,5,6,-2,2,-39,11,-24,16,11,24,-24,6,4,17,-1,16,28,3,-3,10,23,30,-4,9,8,9,-20,-2,-14,11,-14,-11,-21,0z" />
              <path class="berlin-district" fill="url(#berlin-grad)" d="M395,130l63,33,-16,3,-2,9,-16,3,-4,-4,-41,-5,-8,4,-8,-1,-26,7,-13,14,-67,-2,-44,-20,-5,-15,-9,-6,-6,-11,6,-13,-17,-10,-10,-11,23,-21,6,-12,67,2,1,-12,-4,-9,33,-1,2,-17,-5,0,1,-13,37,2,5,4,-15,5,13,15,-5,10,7,11,-12,4,16,-1,36,8,46,-4,13,17,1,10,-9,13,-15,12z" />

              {/* Kontur-Highlights */}
              <use href="#berlin-outline" fill="none" stroke="#1f8ed0" stroke-width="10" opacity=".1" />
              <use href="#berlin-outline" fill="none" stroke="#52cfff" stroke-width="6.2" opacity=".22" />
              <use href="#berlin-outline" fill="none" stroke="#c7f2ff" stroke-width="3.4" class="berlin-outline-main" />

              {/* Muster-Overlay */}
              <g clip-path="url(#berlin-clip)" pointer-events="none">
                <rect x="-40" y="-10" width="1100" height="650" fill="url(#berlin-pat)" opacity=".65" />
              </g>
            </g>
          </svg>
        </div>
      </div>

      {/* Copy + Bezirke */}
      <div class="order-1 lg:order-2" data-ps="src/components/home/v2/BerlinSection.astro:jvsoha">
        <p class="inline-flex items-center gap-2 text-[13px] font-extrabold tracking-[0.08em] uppercase text-[#67C53A] mb-3" data-ps="src/components/home/v2/BerlinSection.astro:wy9p59">
          <span class="w-6 h-[3px] rounded-full bg-[#C99A63]" aria-hidden="true" data-ps="src/components/home/v2/BerlinSection.astro:46br49"></span>
          Einsatzgebiet
        </p>
        <h2 id="berlin-heading" class="font-heading text-[28px] sm:text-[34px] lg:text-[40px] font-black tracking-tight text-white leading-[1.15] mb-4" data-ps="src/components/home/v2/BerlinSection.astro:w1ai46">
          Rauchmelderservice in ganz Berlin
        </h2>
        <p class="text-[16px] text-white/80 leading-relaxed mb-6" data-ps="src/components/home/v2/BerlinSection.astro:wy9p5a">
          Berlin ist unser Zuhause und unser Einsatzgebiet: kurze Anfahrten, realistische Terminplanung und ein Team, das die Stadt kennt: von der Altbauwohnung in Kreuzberg bis zur Wohnanlage in Marzahn.
        </p>

        <ul class="flex flex-wrap gap-2 list-none p-0 m-0 mb-6" aria-label="Alle zwölf Berliner Bezirke">
          {districts.map((d, __psIdx) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-white/10 border border-white/15 px-3.5 py-1.5 text-[13px] font-bold text-white" data-ps={`src/components/home/v2/BerlinSection.astro:kk9ij-${__psIdx}`}>
              <span class="w-1.5 h-1.5 rounded-full bg-[#67C53A] shrink-0" aria-hidden="true" data-ps={`src/components/home/v2/BerlinSection.astro:n1q2of-${__psIdx}`}></span>
              {d.name}
            </li>
          ))}
        </ul>

        <p class="text-[14px] text-white/70 leading-relaxed mb-7" data-ps="src/components/home/v2/BerlinSection.astro:wy9p5b">
          Nach Absprache sind wir auch im Berliner Umland in Brandenburg für Sie im Einsatz. Sprechen Sie uns einfach an.
        </p>

        <a href="#ersteinschaetzung" class="inline-flex items-center gap-2.5 bg-[#67C53A] hover:bg-[#57a82f] text-white text-[15.5px] font-extrabold px-6 py-3.5 rounded-xl no-underline transition-all hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" data-ps="src/components/home/v2/BerlinSection.astro:y6psou">
          Objekt in Berlin anfragen
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </Container>
</section>

<style>
.berlin-map-wrap {
  contain: layout paint;
  content-visibility: auto;
}
.berlin-district {
  stroke: #73cfff;
  stroke-width: 2.4;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
  transition: stroke .18s, opacity .18s;
  transform-box: fill-box;
  transform-origin: center;
}
.berlin-district:hover {
  stroke: #e7f7ff;
  opacity: .96;
}
.berlin-outline-main {
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}
.berlin-shadow {
  fill: #07111f;
  stroke: #18345a;
  stroke-width: 5;
  opacity: .58;
  stroke-linejoin: round;
  vector-effect: non-scaling-stroke;
}
</style>
