---
import Container from '@/components/Container.astro';

const districts = [
  { name: 'Mitte', x: 185, y: 138 },
  { name: 'Friedrichshain-Kreuzberg', x: 228, y: 163 },
  { name: 'Pankow', x: 215, y: 84 },
  { name: 'Charlottenburg-Wilmersdorf', x: 108, y: 158 },
  { name: 'Spandau', x: 58, y: 148 },
  { name: 'Steglitz-Zehlendorf', x: 128, y: 216 },
  { name: 'Tempelhof-Schöneberg', x: 178, y: 190 },
  { name: 'Neukölln', x: 222, y: 201 },
  { name: 'Treptow-Köpenick', x: 302, y: 192 },
  { name: 'Marzahn-Hellersdorf', x: 322, y: 118 },
  { name: 'Lichtenberg', x: 262, y: 133 },
  { name: 'Reinickendorf', x: 132, y: 98 },
];
---

<section id="einsatzgebiet" class="py-14 md:py-20 lg:py-24 bg-white scroll-mt-24" aria-labelledby="berlin-heading">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.05fr] gap-10 lg:gap-14 items-center">

      {/* Abstrahierte Berlin-Karte */}
      <div class="bg-[#F4F8FB] rounded-[22px] border border-[#DCE5EF] p-5 sm:p-7 shadow-[0_10px_30px_rgba(6,43,74,0.06)] order-2 lg:order-1">
        <svg viewBox="0 0 400 300" class="w-full h-auto" role="img" aria-label="Stilisierte Karte von Berlin mit Markierungen aller zwölf Bezirke">
          {/* Abstrahierter Berlin-Umriss */}
          <path
            d="M42 132 L70 92 L118 70 L180 54 L242 60 L300 54 L352 86 L372 130 L362 180 L320 214 L280 240 L220 250 L160 246 L108 230 L68 200 L46 166 Z"
            fill="#EAF1F7"
            stroke="#0B3A64"
            stroke-width="3"
            stroke-linejoin="round"
          />
          {/* Spree-Andeutung */}
          <path d="M60 160 C120 150 160 150 200 142 C250 132 300 150 355 138" fill="none" stroke="#1AAAE6" stroke-width="4" stroke-linecap="round" opacity=".5" />
          {/* Bezirkspunkte */}
          {districts.map((d) => (
            <g>
              <circle cx={d.x} cy={d.y} r="10" fill="#25b94b" opacity=".18" />
              <circle cx={d.x} cy={d.y} r="4.5" fill="#25b94b" stroke="#fff" stroke-width="2" />
            </g>
          ))}
          {/* Stadtzentrum-Markierung */}
          <circle cx="185" cy="138" r="16" fill="none" stroke="#0B3A64" stroke-width="1.6" stroke-dasharray="3 3" opacity=".5" />
        </svg>
        <p class="text-center text-[12.5px] font-bold text-[#5A7191] mt-3 mb-0">Alle 12 Bezirke – stilisiert dargestellt</p>
      </div>

      {/* Copy + Bezirke */}
      <div class="order-1 lg:order-2">
        <p class="inline-flex items-center gap-2 text-[13px] font-extrabold tracking-[0.08em] uppercase text-[#2f7a12] mb-3">
          <span class="w-6 h-[3px] rounded-full bg-[#63c62f]" aria-hidden="true"></span>
          Einsatzgebiet
        </p>
        <h2 id="berlin-heading" class="font-heading text-[28px] sm:text-[34px] lg:text-[40px] font-black tracking-tight text-[#062B4A] leading-[1.15] mb-4">
          Rauchmelderservice in ganz Berlin
        </h2>
        <p class="text-[16px] text-[#3D5068] leading-relaxed mb-6">
          Berlin ist unser Zuhause und unser Einsatzgebiet: kurze Anfahrten, realistische Terminplanung und ein Team, das die Stadt kennt – von der Altbauwohnung in Kreuzberg bis zur Wohnanlage in Marzahn.
        </p>

        <ul class="flex flex-wrap gap-2 list-none p-0 m-0 mb-6" aria-label="Alle zwölf Berliner Bezirke">
          {districts.map((d) => (
            <li class="inline-flex items-center gap-2 rounded-full bg-[#F4F8FB] border border-[#DCE5EF] px-3.5 py-1.5 text-[13px] font-bold text-[#123B66]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#25b94b] shrink-0" aria-hidden="true"></span>
              {d.name}
            </li>
          ))}
        </ul>

        <p class="text-[14px] text-[#5A7191] leading-relaxed mb-7">
          Nach Absprache sind wir auch im Berliner Umland in Brandenburg für Sie im Einsatz – sprechen Sie uns einfach an.
        </p>

        <a href="#ersteinschaetzung" class="inline-flex items-center gap-2.5 bg-[#062B4A] hover:bg-[#0B3A64] text-white text-[15.5px] font-extrabold px-6 py-3.5 rounded-xl no-underline transition-all hover:-translate-y-px focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#062B4A]">
          Objekt in Berlin anfragen
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </Container>
</section>
