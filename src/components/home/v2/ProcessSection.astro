<section id="ablauf" class="flow" aria-labelledby="process-heading" data-ps="src/components/home/v2/ProcessSection.astro:s63kwg">
  {/* Hintergrundbild & Farboverlay beibehalten */}
  <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true" data-ps="src/components/home/v2/ProcessSection.astro:bg-wrap">
    <img
      src="https://pagesmith-cdn.com/0c80a694/images/paul-lichtblau-uMId2WIsWyM-unsplash-1024-58005d-1024.webp"
      srcset="https://pagesmith-cdn.com/0c80a694/images/paul-lichtblau-uMId2WIsWyM-unsplash-1024-58005d-320.webp 320w, https://pagesmith-cdn.com/0c80a694/images/paul-lichtblau-uMId2WIsWyM-unsplash-1024-58005d-640.webp 640w, https://pagesmith-cdn.com/0c80a694/images/paul-lichtblau-uMId2WIsWyM-unsplash-1024-58005d-768.webp 768w, https://pagesmith-cdn.com/0c80a694/images/paul-lichtblau-uMId2WIsWyM-unsplash-1024-58005d-1024.webp 1024w"
      sizes="100vw"
      alt=""
      class="w-full h-full object-cover object-center"
      loading="lazy" data-ps="src/components/home/v2/ProcessSection.astro:bg-img" />
  </div>
  <div class="shade" data-ps="src/components/home/v2/ProcessSection.astro:pdsq17"></div>

  <div class="fi" data-ps="src/components/home/v2/ProcessSection.astro:pdsq16">
    <div class="ey" data-ps="src/components/home/v2/ProcessSection.astro:pdsq15">DER ABLAUF</div>
    <h2 id="process-heading" data-ps="src/components/home/v2/ProcessSection.astro:8ddr6f">Unser-Service:   So läuft es ab</h2>
    <p class="intro" data-ps="src/components/home/v2/ProcessSection.astro:mc7oz6">Vier Schritte von der Anfrage bis zum fertigen Protokoll. Sie müssen sich um nichts<br>kümmern, außer uns kurz Ihr Objekt zu beschreiben.</p>

    <div class="steps" data-ps="src/components/home/v2/ProcessSection.astro:pdsq14">
      <div class="line" data-ps="src/components/home/v2/ProcessSection.astro:pdsq13"></div>

      <article data-ps="src/components/home/v2/ProcessSection.astro:mxnc4c">
        <div class="ib" data-ps="src/components/home/v2/ProcessSection.astro:pdsq12"><b>1</b><svg viewBox="0 0 64 64"><path d="M10 30 54 12 38 54 29 36Z"/><path d="m29 36 25-24"/></svg></div>
        <h3 data-ps="src/components/home/v2/ProcessSection.astro:n1soe3">Anfrage senden</h3>
        <p data-ps="src/components/home/v2/ProcessSection.astro:mc7oz7">Beschreiben Sie kurz Ihr Objekt und die gewünschte Leistung: Grobe Angaben reichen. Online übers Formular oder direkt am Telefon.</p>
      </article>

      <article data-ps="src/components/home/v2/ProcessSection.astro:mxnc4d">
        <div class="ib" data-ps="src/components/home/v2/ProcessSection.astro:pdsq11"><b>2</b><svg viewBox="0 0 64 64"><rect x="12" y="17" width="40" height="35" rx="5"/><path d="M12 27h40M22 11v12M42 11v12m-19 17 6 6 12-14"/></svg></div>
        <h3 data-ps="src/components/home/v2/ProcessSection.astro:n1soe2">Termin und Objekt<br>abstimmen</h3>
        <p data-ps="src/components/home/v2/ProcessSection.astro:mc7ozt">Wir melden uns persönlich, klären offene Fragen und finden einen verbindlichen Termin, auf Wunsch direkt mit Ihren Mietern koordiniert.</p>
      </article>

      <article data-ps="src/components/home/v2/ProcessSection.astro:mxnc4e">
        <div class="ib" data-ps="src/components/home/v2/ProcessSection.astro:pdsq10"><b>3</b><svg viewBox="0 0 64 64"><path d="M41 10a14 14 0 0 0-12 19L12 46a5 5 0 0 0 7 7l17-17a14 14 0 0 0 18-13l-9 7-8-2-2-8Z"/></svg></div>
        <h3 data-ps="src/components/home/v2/ProcessSection.astro:n1soe1">Installation oder<br>Wartung durchführen</h3>
        <p data-ps="src/components/home/v2/ProcessSection.astro:mc7ozu">Wir montieren und prüfen sauber und zügig und sagen Ihnen offen, wenn etwas nicht gemacht werden muss.</p>
      </article>

      <article data-ps="src/components/home/v2/ProcessSection.astro:1juqdy">
        <div class="ib" data-ps="src/components/home/v2/ProcessSection.astro:pdsq0z"><b>4</b><svg viewBox="0 0 64 64"><path d="M18 9h22l10 10v36H18Z"/><path d="M40 9v12h10M25 35l5 5 10-12"/></svg></div>
        <h3 data-ps="src/components/home/v2/ProcessSection.astro:n1soe0">Dokumentation<br>erhalten</h3>
        <p data-ps="src/components/home/v2/ProcessSection.astro:t2e85d">Sie erhalten Ihr digitales Protokoll: alle Geräte, alle Ergebnisse, alle Maßnahmen, inklusive Hinweis zum nächsten Termin.</p>
      </article>
    </div>

    <a class="cta" href="#ersteinschaetzung" data-ps="src/components/home/v2/ProcessSection.astro:su504k">Schritt 1 jetzt starten: Anfrage senden <span data-ps="src/components/home/v2/ProcessSection.astro:iqkqqt">→</span></a>
  </div>
</section>

<style>
.flow,.flow *{box-sizing:border-box}
.flow{position:relative;overflow:hidden;min-height:850px;padding:64px 30px 60px;font-family:var(--font-sans, Inter, Arial, sans-serif);color:#fff}
.shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(2,27,51,.9),rgba(11,52,79,.86) 50%,rgba(2,27,51,.91)),rgba(5,35,58,.55);backdrop-filter:blur(1px)}
.fi{position:relative;z-index:2;max-width:1500px;margin:auto;text-align:center}
.ey{display:flex;align-items:center;justify-content:center;gap:14px;color:#66d52f;font-size:15px;font-weight:900;letter-spacing:2px}
.ey:before,.ey:after{content:"";width:38px;height:3px;border-radius:5px;background:#61cf30}
.flow h2{margin:25px auto 19px;max-width:900px;font-size:clamp(36px,4.2vw,58px);line-height:1.08;letter-spacing:-2px;font-weight:900}
.intro{margin:0 auto;color:#cad6df;font-size:clamp(17px,1.4vw,21px);line-height:1.55}
.steps{position:relative;display:grid;grid-template-columns:repeat(4,1fr);gap:40px;margin-top:72px}
.line{position:absolute;z-index:0;left:10%;right:10%;top:40px;height:4px;background:linear-gradient(90deg,#55d72f,#59d736 38%,#90a9ba 55%,#748d9d)}
.steps article{position:relative;z-index:2}
.ib{position:relative;width:82px;height:82px;margin:0 auto 32px;border:1px solid rgba(126,220,217,.75);border-radius:22px;display:grid;place-items:center;background:linear-gradient(145deg,rgba(25,74,101,.96),rgba(4,42,69,.98));box-shadow:0 0 0 1px rgba(255,255,255,.08),inset 0 1px rgba(255,255,255,.16),0 12px 30px rgba(0,0,0,.28),0 0 22px rgba(54,220,134,.19)}
.ib:before{content:"";position:absolute;inset:3px;border-radius:18px;background:linear-gradient(135deg,rgba(255,255,255,.17),transparent 36%);pointer-events:none}
.ib svg{width:45px;height:45px;fill:none;stroke:#72e34c;stroke-width:3.4;stroke-linecap:round;stroke-linejoin:round}
.ib b{position:absolute;z-index:4;right:-12px;top:-12px;width:31px;height:31px;display:grid;place-items:center;border-radius:50%;background:#20bf50;color:white;border:3px solid #163f57;font-size:16px;font-weight:900}
.steps h3{margin:0 auto 15px;font-size:clamp(20px,1.8vw,25px);line-height:1.2;font-weight:900}
.steps p{margin:0 auto;max-width:300px;color:#cfdae3;font-size:clamp(14.5px,1.15vw,17px);line-height:1.6}
.cta{display:inline-flex;align-items:center;justify-content:center;gap:16px;min-width:440px;margin-top:60px;padding:18px 34px;border-radius:14px;background:linear-gradient(135deg,#29c654,#12af42);box-shadow:0 13px 30px rgba(19,185,68,.26);color:#fff;text-decoration:none;font-size:20px;font-weight:900;transition:.2s}
.cta span{font-size:28px;line-height:1}
.cta:hover{transform:translateY(-2px)}
@media(max-width:1000px){
  .steps{grid-template-columns:1fr 1fr;gap:45px 24px;margin-top:55px}
  .line{display:none}
  .intro br{display:none}
  .cta{margin-top:45px;min-width:340px}
}
@media(max-width:600px){
  .flow{padding:40px 16px 44px}
  .flow h2{font-size:32px;letter-spacing:-1.2px}
  .intro{font-size:15.5px}
  .steps{grid-template-columns:1fr;gap:34px;margin-top:44px}
  .ib{margin-bottom:18px}
  .steps p{max-width:360px}
  .cta{width:100%;min-width:0;margin-top:36px;padding:16px 18px;font-size:16.5px}
  .cta span{font-size:22px}
}
</style>
