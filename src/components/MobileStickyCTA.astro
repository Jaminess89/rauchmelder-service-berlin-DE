---
interface Props {
  phoneNumber: string;
  phoneLabel?: string;
  enquiryLabel?: string;
  enquiryTarget?: string;
}

const { 
  phoneNumber, 
  phoneLabel = "Anrufen", 
  enquiryLabel = "Kosten-Check", 
  enquiryTarget = "#ersteinschaetzung" 
} = Astro.props;

// Clean phone number for tel: link
const telLink = phoneNumber.replace(/\s/g, '');
---

<div class="mobile-sticky-cta" data-ps="src/components/MobileStickyCTA.astro:main">
  <a 
    href={enquiryTarget} 
    class="mobile-sticky-cta__button mobile-sticky-cta__button--enquiry"
    aria-label="Kostenlose Anfrage"
    data-ps="src/components/MobileStickyCTA.astro:enquiry-btn"
  >
    <span class="mobile-sticky-cta__text" data-ps="src/components/MobileStickyCTA.astro:kys42d">Kostenlose Anfrage</span>
  </a>
  <a 
    href={`tel:${telLink}`} 
    class="mobile-sticky-cta__button mobile-sticky-cta__button--phone"
    aria-label="Jetzt telefonisch Kontakt aufnehmen"
    data-ps="src/components/MobileStickyCTA.astro:phone-btn"
  >
    <span class="mobile-sticky-cta__icon" aria-hidden="true" data-ps="src/components/MobileStickyCTA.astro:kys42d">
      <svg viewBox="0 0 48 48" class="w-5 h-5">
        <path d="M14 7 8 11c-2 2 1 11 8 19s16 12 19 10l5-6-10-7-5 5c-5-3-9-7-11-12l5-4z"/>
      </svg>
    </span>
    <span class="mobile-sticky-cta__text" data-ps="src/components/MobileStickyCTA.astro:kys42c">{phoneLabel}</span>
  </a>
</div>

<style>
  .mobile-sticky-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 1000;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0.35rem 0.75rem calc(0.35rem + env(safe-area-inset-bottom));
    background: transparent;
    pointer-events: none;
  }

  .mobile-sticky-cta__button {
    pointer-events: auto;
    min-width: 0;
    min-height: 41px;
    padding: 0 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 50px;
    color: #fff;
    text-decoration: none;
    font-family: inherit;
    font-weight: 900;
    letter-spacing: -0.01em;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .mobile-sticky-cta__button:active {
    transform: scale(0.97);
  }

  /* Grüner Glas-Button ohne Icon */
  .mobile-sticky-cta__button--enquiry {
    border: 1.5px solid rgba(103, 235, 66, 0.9);
    background: linear-gradient(
      180deg,
      rgba(49, 184, 54, 0.75),
      rgba(16, 137, 41, 0.7)
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.25),
      inset 0 -1px 0 rgba(0, 80, 25, 0.2),
      0 0 12px rgba(66, 230, 49, 0.3);
  }

  /* Telefon Glas-Button mit Icon */
  .mobile-sticky-cta__button--phone {
    border: 1.5px solid rgba(190, 211, 225, 0.4);
    background: linear-gradient(
      180deg,
      rgba(70, 104, 132, 0.4),
      rgba(36, 71, 100, 0.35)
    );
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: inset 0 1px rgba(255, 255, 255, 0.12);
  }

  .mobile-sticky-cta__icon {
    width: 24px;
    height: 24px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(132, 164, 190, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .mobile-sticky-cta__icon svg {
    fill: none;
    stroke: #fff;
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mobile-sticky-cta__text {
    font-size: clamp(0.85rem, 3.6vw, 0.95rem);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: #fff;
  }

  @media (min-width: 769px) {
    .mobile-sticky-cta {
      display: none;
    }
  }
</style>
